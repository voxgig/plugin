{
  "name": "@voxgig/plugin",
  "version": "0.1.0",
  "description": "Plugin: multi-language plugin architecture (TypeScript, canonical)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxgig/plugin.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/voxgig/plugin/tree/main/typescript",
  "bugs": {
    "url": "https://github.com/voxgig/plugin/issues"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "src",
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test-some": "npm run build && node --test --test-name-pattern=$npm_config_pattern \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
