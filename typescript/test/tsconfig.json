{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "commonjs",
    "noEmitOnError": true,
    "outDir": "../dist-test",
    "rootDir": ".",
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2021",
    "lib": [
      "es2021"
    ],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "../.tsbuild/test.tsbuildinfo"
  }
}
