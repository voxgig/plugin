


PLUGIN: version: 1

OMNI: version: 1



primary: ref: {

  parse: set: [
    { id: 'ref/parse#bare', doc: true, in: 'stripe', out: { name: 'stripe', tag: '' } }
    { in: 'stripe$test', out: { name: 'stripe', tag: 'test' } }
    { in: 'retry$fast', out: { name: 'retry', tag: 'fast' } }

    { in: 'stripe$', out: { name: 'stripe', tag: '' } }

    { in: '@voxgig/plugin-retry', out: { name: '@voxgig/plugin-retry', tag: '' } }
    { in: '@voxgig/plugin-retry$eu', out: { name: '@voxgig/plugin-retry', tag: 'eu' } }
    { in: 'a.b.c', out: { name: 'a.b.c', tag: '' } }
    { in: 'a_b-c~d', out: { name: 'a_b-c~d', tag: '' } }
    { in: 'a/b/c$x', out: { name: 'a/b/c', tag: 'x' } }
    { in: 'A', out: { name: 'A', tag: '' } }
    { in: 'a1', out: { name: 'a1', tag: '' } }

    # Integer tags are what auto-tagging assigns, so they must parse as
    # ordinary tags — nothing distinguishes stripe$1 from stripe$test here.
    { in: 'stripe$1', out: { name: 'stripe', tag: '1' } }
    { in: 'stripe$0', out: { name: 'stripe', tag: '0' } }
    { in: 'stripe$99', out: { name: 'stripe', tag: '99' } }
    { in: 'x$a.b', out: { name: 'x', tag: 'a.b' } }
    { in: 'x$a_b-c~d', out: { name: 'x', tag: 'a_b-c~d' } }
  ]


  parsebad: set: [
    { id: 'ref/parsebad#empty', doc: true, in: '', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: '$test', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: '$', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: '1abc', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: '-abc', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: '.abc', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: '/abc', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: '~abc', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: '_abc', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: 'a b', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: 'a!b', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: 'a#b', err: true, match: { err: { code: 'plugin_bad_name' } } }
    # ...and through the public entry, not only the predicate, so a port
    # cannot fix one and leave the other.
    { id: 'ref/parsebad#trailing-newline', in: "abc\n", err: true, match: { err: { code: 'plugin_bad_name' } } }
    { in: "a$b\n", err: true, match: { err: { code: 'plugin_bad_tag' } } }

    { in: 'a$b$c', err: true, match: { err: { code: 'plugin_bad_tag' } } }
    { in: 'a$b/c', err: true, match: { err: { code: 'plugin_bad_tag' } } }
    { in: 'a$@b', err: true, match: { err: { code: 'plugin_bad_tag' } } }
    { in: 'a$b c', err: true, match: { err: { code: 'plugin_bad_tag' } } }
    { in: 'a$b!c', err: true, match: { err: { code: 'plugin_bad_tag' } } }

    { id: 'ref/parsebad#name-overlong', in: '', err: true, match: { err: { code: 'plugin_bad_name' } } }
    { id: 'ref/parsebad#tag-overlong', in: 'x$', err: true, match: { err: { code: 'plugin_bad_tag' } } }
  ]


  format: set: [
    { id: 'ref/format#bare', doc: true, args: ['stripe', ''], out: 'stripe' }
    { args: ['stripe', 'test'], out: 'stripe$test' }
    { args: ['@voxgig/plugin-retry', 'eu'], out: '@voxgig/plugin-retry$eu' }
    { args: ['stripe', '1'], out: 'stripe$1' }
    { args: ['a.b.c', 'x~y'], out: 'a.b.c$x~y' }

    # An empty tag NEVER writes the separator. This is the half of
    # canonicalization that formatref owns: parse tolerates `stripe$`,
    # format never produces it, so a round trip is idempotent.
    { args: ['stripe', ''], out: 'stripe' }
  ]


  formatbad: set: [
    { id: 'ref/formatbad#emptyname', doc: true, args: ['', ''], err: true, match: { err: { code: 'plugin_bad_name' } } }
    { args: ['', 'test'], err: true, match: { err: { code: 'plugin_bad_name' } } }
    { args: ['1abc', ''], err: true, match: { err: { code: 'plugin_bad_name' } } }
    { args: ['a$b', ''], err: true, match: { err: { code: 'plugin_bad_name' } } }
    { args: ['stripe', 'a/b'], err: true, match: { err: { code: 'plugin_bad_tag' } } }
    { args: ['stripe', 'a$b'], err: true, match: { err: { code: 'plugin_bad_tag' } } }
    { args: ['stripe', '@x'], err: true, match: { err: { code: 'plugin_bad_tag' } } }

    # And through formatref, which is the other public operation the
    # maximum applies to.
    { id: 'ref/formatbad#name-overlong', args: ['', ''], err: true, match: { err: { code: 'plugin_bad_name' } } }
    { id: 'ref/formatbad#tag-overlong', args: ['x', ''], err: true, match: { err: { code: 'plugin_bad_tag' } } }
  ]


  # formatref(parseref(s)) — the canonical spelling of s. §4 rule 5: ports
  # must canonicalize before comparison, and this group is the arbiter.
  # Every entry is also an idempotence check, because the output of canon
  # is itself a valid input to canon.
  canon: set: [
    { id: 'ref/canon#trailing', doc: true, in: 'stripe$', out: 'stripe' }
    { in: 'stripe', out: 'stripe' }
    { in: 'stripe$test', out: 'stripe$test' }
    { in: '@voxgig/plugin-retry$', out: '@voxgig/plugin-retry' }
    { in: 'a.b.c$1', out: 'a.b.c$1' }
  ]


  # checkname(str) -> boolean. A predicate, not a raiser: the caller that
  # wants an error has parseref for that.
  name: set: [
    { id: 'ref/name#simple', doc: true, in: 'stripe', out: true }
    { in: 'a', out: true }
    { in: 'A', out: true }
    { in: '@scope/pkg', out: true }
    { in: '@voxgig/plugin-retry', out: true }
    { in: 'a.b.c', out: true }
    { in: 'a_b', out: true }
    { in: 'a-b', out: true }
    { in: 'a~b', out: true }
    { in: 'a/b', out: true }
    { in: 'a1', out: true }
    { in: 'a123._~-/', out: true }

    { in: '', out: false }
    { in: '1a', out: false }
    { in: '-a', out: false }
    { in: '.a', out: false }
    { in: '_a', out: false }
    { in: '~a', out: false }
    { in: '/a', out: false }
    { in: 'a$b', out: false }
    { in: 'a b', out: false }
    { id: 'ref/name#trailing-newline', in: "abc\n", out: false }
    { in: 'a!b', out: false }
    { in: 'a%b', out: false }
  ]


  # checktag(str) -> boolean. The empty tag is VALID and ordinary (§4 rule
  # 2) — the single-instance case writes no tag and never learns tags exist.
  tag: set: [
    { id: 'ref/tag#empty', doc: true, in: '', out: true }
    { in: 'test', out: true }
    { in: '1', out: true }
    { in: '0', out: true }
    { in: '99', out: true }
    { in: 'a.b', out: true }
    { in: 'a_b', out: true }
    { in: 'a-b', out: true }
    { in: 'a~b', out: true }
    { in: 'A1._~-', out: true }

    { in: '@x', out: false }
    { in: 'a/b', out: false }
    { in: 'a$b', out: false }
    { in: 'a b', out: false }
    { in: 'a!b', out: false }
    # The same anchor trap as the name grammar, and it needs its own
    # entry: a port that fixed `check_name` and left `check_tag` alone
    # would pass every other entry here.
    { id: 'ref/tag#trailing-newline', in: "abc\n", out: false }
  ]


  bound: set: [
    { id: 'ref/bound#name-max', doc: true, in: '', out: true }
    { in: '', out: false }
  ]


  # checktag at the same boundary. Separate group because the subject
  # differs — `bound` runs checkname, `boundtag` runs checktag.
  boundtag: set: [
    { id: 'ref/boundtag#max', doc: true, in: '', out: true }
    { in: '', out: false }
  ]
}



primary: config: {

  # Map form. Load order is the SORTED refs — byte-stable, so output does
  # not depend on the parser's key order.
  normmap: set: [
    {
      id: 'config/normmap#order', doc: true
      in: { doc: { plugin: 1, instance: { retry: {}, alpha: {}, 'memcache$hot': {} } } }
      match: { out: { order: ['alpha', 'memcache$hot', 'retry'] } }
    }
    {
      in: { doc: { plugin: 1, instance: { 'stripe$test': {}, stripe: {}, 'stripe$eu': {} } } }
      match: { out: { order: ['stripe', 'stripe$eu', 'stripe$test'] } }
    }
    {
      id: 'config/normmap#bytewise'
      in: { doc: { plugin: 1, instance: { a: {}, A: {}, '@scope/x': {}, B: {}, b: {} } } }
      match: { out: { order: ['@scope/x', 'A', 'B', 'a', 'b'] } }
    }
    # An empty document normalizes to an empty instance map and empty order,
    # not to an error and not to a missing key.
    {
      in: { doc: { plugin: 1 } }
      match: { out: { order: [], instance: {} } }
    }
    # `pos` ITSELF, not only its effect on `order` (§4 rule 4). For the
    # map form it is the SORTED-ref index, so it does not depend on the
    # parser's key order. Asserting only `order` would let a port derive
    # the list correctly while carrying a `pos` that disagrees with it —
    # and `pos` is what breaks ordering ties (§7), so the two must agree.
    {
      id: 'config/normmap#pos'
      in: { doc: { plugin: 1, instance: { retry: {}, alpha: {}, zeta: {} } } }
      match: { out: { instance: { alpha: { pos: 0 }, retry: { pos: 1 }, zeta: { pos: 2 } } } }
    }
  ]


  normorder: set: [
    {
      id: 'config/normorder#scalar', doc: true
      in: { doc: { plugin: 1, instance: { retry: {}, alpha: { order: { after: 'retry' } } } } }
      match: { out: { instance: { alpha: { order: { after: 'retry', before: '__UNDEF__', band: '__UNDEF__' } } } } }
    }
    {
      id: 'config/normorder#one-element-list'
      in: { doc: { plugin: 1, instance: { retry: {}, alpha: { order: { after: ['retry'] } } } } }
      match: { out: { instance: { alpha: { order: { after: ['retry'], before: '__UNDEF__', band: '__UNDEF__' } } } } }
    }
    {
      id: 'config/normorder#many'
      in: { doc: { plugin: 1, instance: { retry: {}, zeta: {}, alpha: { order: { after: ['retry', 'zeta'] } } } } }
      match: { out: { instance: { alpha: { order: { after: ['retry', 'zeta'], before: '__UNDEF__', band: '__UNDEF__' } } } } }
    }
    {
      id: 'config/normorder#empty-list-survives'
      in: { doc: { plugin: 1, instance: { alpha: { order: { after: [] } } } } }
      match: { out: { instance: { alpha: { order: { after: [], before: '__UNDEF__', band: '__UNDEF__' } } } } }
    }
    # An authored null is a null. A typed port that decodes `null` through
    # a string branch invents an empty-string constraint nobody wrote —
    # worse than dropping it, because it then names a binding.
    {
      id: 'config/normorder#null-survives'
      in: { doc: { plugin: 1, instance: { alpha: { order: { after: null } } } } }
      match: { out: { instance: { alpha: { order: { after: '__NULL__', before: '__UNDEF__', band: '__UNDEF__' } } } } }
    }
    # `band` alone leaves BOTH constraint keys absent — not null, not
    # empty. A port that materializes its zero value emits them anyway.
    {
      id: 'config/normorder#band-only'
      in: { doc: { plugin: 1, instance: { alpha: { order: { band: 2 } } } } }
      match: { out: { instance: { alpha: { order: { band: 2, before: '__UNDEF__', after: '__UNDEF__' } } } } }
    }
  ]


  # Array form. The array POSITION is the load order (§9.1) — the same
  # contract as sdkgen's ordered-array feature form.
  normarray: set: [
    {
      id: 'config/normarray#order', doc: true
      in: { doc: { plugin: 1, instance: [ { ref: 'retry' }, { ref: 'alpha' }, { ref: 'memcache$hot' } ] } }
      match: { out: { order: ['retry', 'alpha', 'memcache$hot'] } }
    }
    # The array becomes the same map the map form produces: one normalized
    # shape downstream, whichever form was authored.
    {
      in: { doc: { plugin: 1, instance: [ { ref: 'retry', options: { retries: 3 } } ] } }
      match: { out: { instance: { retry: { optionlayers: [ { retries: 3 } ] } } } }
    }
    {
      in: { doc: { plugin: 1, instance: [ { ref: 'stripe$' } ] } }
      match: { out: { order: ['stripe'] } }
    }
    {
      id: 'config/normarray#pos'
      in: { doc: { plugin: 1, instance: [ { ref: 'zeta' }, { ref: 'alpha' }, { ref: 'retry' } ] } }
      match: { out: { instance: { zeta: { pos: 0 }, alpha: { pos: 1 }, retry: { pos: 2 } } } }
    }
    # And in the MAP form, where refs arrive as keys through a different
    # code path — a port can canonicalize array `ref` fields while
    # copying a key like `stripe$` through unchanged.
    {
      id: 'config/normarray#mapkey-canon'
      in: { doc: { plugin: 1, instance: { 'stripe$': {} } } }
      match: { out: { order: ['stripe'], instance: { stripe: '__EXISTS__' } } }
    }
  ]


  # A PARTIAL ARRAY IS NOT A FILTER (§9.1). sdkgen learned this the hard
  # way: deriving order from a partial array silently dropped
  # config-activated features. Refs in the base map but absent from the
  # array still load, in sorted position AFTER the listed ones.
  normpartial: set: [
    {
      id: 'config/normpartial#keep', doc: true
      in: {
        profile: 'dev'
        doc: {
          plugin: 1
          instance: { retry: {}, alpha: {}, zeta: {} }
          profile: { dev: { instance: [ { ref: 'zeta' } ] } }
        }
      }
      match: { out: { order: ['zeta', 'alpha', 'retry'] } }
    }
    {
      in: {
        profile: 'dev'
        doc: {
          plugin: 1
          instance: { retry: {}, alpha: {}, zeta: {} }
          profile: { dev: { instance: [ { ref: 'zeta' } ] } }
        }
      }
      match: { out: { instance: { retry: '__EXISTS__', alpha: '__EXISTS__', zeta: '__EXISTS__' } } }
    }
    # A SELECTED PROFILE MAY INTRODUCE A REF THE BASE NEVER DECLARED.
    # Every other case here starts with the ref already in the base map,
    # so a normalizer that filters profile entries to the base ref set
    # passes them all — and drops an integration declared only for prod.
    {
      id: 'config/normpartial#introduce'
      in: {
        profile: 'prod'
        doc: {
          plugin: 1
          instance: { retry: {} }
          profile: { prod: { instance: { 'audit$eu': { options: { region: 'eu' } } } } }
        }
      }
      match: { out: { order: ['audit$eu', 'retry']
                      instance: { 'audit$eu': { optionlayers: [ { region: 'eu' } ] } } } }
    }
    # A PROFILE ARRAY ELEMENT IS A CONFIGURATION ENTRY, NOT JUST AN
    # ORDERING TOKEN. Both cases above use elements carrying only `ref`,
    # so a normalizer that reads a profile array purely as an order list
    # and discards `active`/`start`/`options` passes them.
    {
      id: 'config/normpartial#arrayoptions'
      in: {
        profile: 'dev'
        doc: {
          plugin: 1
          instance: { zeta: { options: { a: 1 } } }
          profile: { dev: { instance: [ { ref: 'zeta', active: false, options: { b: 2 } } ] } }
        }
      }
      match: { out: { instance: { zeta: { active: false
                                          optionlayers: [ { a: 1 }, { b: 2 } ] } } } }
    }
  ]


  # DEFAULTS ARE APPLIED AFTER THE MERGE, NEVER BEFORE IT (§9.3).
  # A safety rule, not a tidiness one, and the first entry is the case
  # station supplied that shows why.
  normdefaults: set: [
    {
      id: 'config/normdefaults#bar', doc: true
      in: {
        profile: 'prod'
        doc: {
          plugin: 1
          instance: { 'pad$a': { active: false } }
          profile: { prod: { instance: { 'pad$a': { options: { base: 'https://prod.example' } } } } }
        }
      }
      match: { out: { instance: { 'pad$a': { active: false
                                             optionlayers: [ { base: 'https://prod.example' } ] } } } }
    }
    {
      in: { doc: { plugin: 1, instance: { retry: {} } } }
      match: { out: { instance: { retry: { active: true, start: 'eager' } } } }
    }
    {
      in: { doc: { plugin: 1, instance: { retry: { active: false, start: 'lazy' } } } }
      match: { out: { instance: { retry: { active: false, start: 'lazy' } } } }
    }
    {
      in: {
        profile: 'prod'
        doc: {
          plugin: 1
          instance: { outer: { options: { instance: { inner: { active: false } } } } }
          profile: { prod: { instance: { outer: { options: { instance: { inner: { options: { x: 1 } } } } } } } }
        }
      }
      match: { out: { instance: { outer: { optionlayers: [
        { instance: { inner: { active: false } } }
        { instance: { inner: { options: { x: 1 } } } }
      ] } } } }
    }
  ]


  normkeys: set: [
    {
      id: 'config/normkeys#root', doc: true
      in: {
        keys: { instance: 'sdk', default: 'api' }
        doc: { plugin: 1, sdk: { retry: {} }, api: { retry: { options: { t: 1 } } } }
      }
      match: { out: { order: ['retry'], default: { retry: { options: { t: 1 } } } } }
    }
    # BOTH renamed keys must map, not just the instance one. A port that
    # maps `sdk`->instance while DROPPING `api` passes an order-only
    # assertion and loses every host-wide definition default.
    {
      in: {
        keys: { instance: 'sdk', default: 'api' }
        doc: { plugin: 1, sdk: { 'retry$a': {} }, api: { retry: { options: { t: 9 } } } }
      }
      match: { out: { default: { retry: { options: { t: 9 } } } } }
    }
    # The profile overlay root too. A rename applied only at the document
    # root would leave profile.prod.sdk untranslated and SILENTLY DROP
    # every environment override the host depends on.
    {
      in: {
        keys: { instance: 'sdk', default: 'api' }
        profile: 'prod'
        doc: {
          plugin: 1
          sdk: { retry: { options: { t: 1 } } }
          profile: { prod: { sdk: { retry: { options: { t: 2 } } } } }
        }
      }
      match: { out: { instance: { retry: { optionlayers: [ { t: 1 }, { t: 2 } ] } } } }
    }
    {
      in: {
        keys: { instance: 'sdk', default: 'api' }
        doc: { plugin: 1, sdk: { retry: { options: { sdk: 'untouched' } } } }
      }
      match: { out: { instance: { retry: { optionlayers: [ { sdk: 'untouched' } ] } } } }
    }
  ]


  # Reserved refs (§9.1). A configuration surface that can disable the
  # thing reading it is not a surface, it is a trap. The reservation is
  # all-or-nothing per NAME, so the tagged forms go too.
  normreserved: set: [
    {
      id: 'config/normreserved#doc', doc: true
      in: { reserved: ['station'], doc: { plugin: 1, instance: { station: {} } } }
      err: true, match: { err: { code: 'plugin_ref_reserved' } }
    }
    {
      in: { reserved: ['station'], doc: { plugin: 1, instance: { 'station$eu': {} } } }
      err: true, match: { err: { code: 'plugin_ref_reserved' } }
    }
    {
      in: { reserved: ['station'], doc: { plugin: 1, default: { station: {} } } }
      err: true, match: { err: { code: 'plugin_ref_reserved' } }
    }
    {
      in: {
        reserved: ['station'], profile: 'prod'
        doc: { plugin: 1, profile: { prod: { instance: { station: {} } } } }
      }
      err: true, match: { err: { code: 'plugin_ref_reserved' } }
    }
    {
      in: { reserved: ['station'], doc: { plugin: 1, instance: { stationary: {} } } }
      match: { out: { order: ['stationary'] } }
    }
  ]


  normdefaultmap: set: [
    {
      id: 'config/normdefaultmap#inert', doc: true
      in: { doc: { plugin: 1, default: { stripe: { options: { t: 5000 } } } } }
      match: { out: { order: [], instance: {} } }
    }
    {
      in: { doc: { plugin: 1, default: { stripe: { options: { t: 5000 } } } } }
      match: { out: { default: { stripe: { options: { t: 5000 } } } } }
    }
    # A `default` entry for a name with NO instances is inert rather than
    # an error (§9.3) — that is what makes a shared library of defaults
    # shippable.
    {
      in: { doc: { plugin: 1, default: { nobody: { options: { t: 1 } } }, instance: { retry: {} } } }
      match: { out: { order: ['retry'] } }
    }
    # And `default.stripe` beside `instance.stripe` still declares ONE
    # instance, not two: separate namespaces, same key string.
    {
      in: { doc: { plugin: 1, default: { stripe: { options: { a: 1 } } }
                   instance: { stripe: {}, 'stripe$test': {} } } }
      match: { out: { order: ['stripe', 'stripe$test'] } }
    }
  ]


  optladder: set: [
    { id: 'config/optladder#1', doc: true
      in: { ref: 'r', shape: { t: 1 } }, out: { t: 1 } }
    { in: { ref: 'r', shape: { t: 1 }, hostdefaults: { t: 2 } }, out: { t: 2 } }
    { in: { ref: 'r', shape: { t: 1 }, hostdefaults: { t: 2 }
            doc: { default: { r: { options: { t: 3 } } } } }, out: { t: 3 } }
    { in: { ref: 'r', doc: { default: { r: { options: { t: 3 } } }
                             instance: { r: { options: { t: 4 } } } } }, out: { t: 4 } }
    { in: { ref: 'r', profile: 'p'
            doc: { instance: { r: { options: { t: 4 } } }
                   profile: { p: { default: { r: { options: { t: 5 } } } } } } }, out: { t: 5 } }
    { in: { ref: 'r', profile: 'p'
            doc: { profile: { p: { default: { r: { options: { t: 5 } } }
                                   instance: { r: { options: { t: 6 } } } } } } }, out: { t: 6 } }
    { in: { ref: 'r', doc: { instance: { r: { options: { t: 4 } } } }, env: { t: 7 } }, out: { t: 7 } }
    { in: { ref: 'r', env: { t: 7 }, hostoptions: { t: 8 } }, out: { t: 8 } }
    { in: { ref: 'r', hostoptions: { t: 8 }, loadoptions: { t: 9 } }, out: { t: 9 } }
    { in: { ref: 'r', loadoptions: { t: 9 }, patch: { t: 10 } }, out: { t: 10 } }

    { id: 'config/optladder#7-beats-6'
      in: { ref: 'r', profile: 'p'
            doc: { profile: { p: { instance: { r: { options: { t: 6 } } } } } }
            env: { t: 7 } }, out: { t: 7 } }
    { in: { ref: 'r', profile: 'p'
            doc: { profile: { p: { default: { r: { options: { t: 5 } } } } } }
            env: { t: 7 } }, out: { t: 7 } }
    { in: { ref: 'r', shape: { t: 1 }, patch: { t: 10 } }, out: { t: 10 } }
    { in: { ref: 'r', hostdefaults: { t: 2 }, hostoptions: { t: 8 } }, out: { t: 8 } }
    { in: { ref: 'r', doc: { default: { r: { options: { t: 3 } } } }, loadoptions: { t: 9 } }, out: { t: 9 } }
    { in: { ref: 'r', profile: 'p'
            doc: { default: { r: { options: { t: 3 } } }
                   profile: { p: { instance: { r: { options: { t: 6 } } } } } } }, out: { t: 6 } }
    { in: { ref: 'r', shape: { t: 1 }, env: { t: 7 } }, out: { t: 7 } }
    { id: 'config/optladder#all-ten'
      in: { ref: 'r', profile: 'p'
            shape: { t: 1 }, hostdefaults: { t: 2 }
            doc: { default: { r: { options: { t: 3 } } }
                   instance: { r: { options: { t: 4 } } }
                   profile: { p: { default: { r: { options: { t: 5 } } }
                                   instance: { r: { options: { t: 6 } } } } } }
            env: { t: 7 }, hostoptions: { t: 8 }, loadoptions: { t: 9 }, patch: { t: 10 } }
      out: { t: 10 } }
    { in: { ref: 'r', profile: 'p'
            shape: { t: 1 }, hostdefaults: { t: 2 }
            doc: { default: { r: { options: { t: 3 } } }
                   instance: { r: { options: { t: 4 } } }
                   profile: { p: { default: { r: { options: { t: 5 } } }
                                   instance: { r: { options: { t: 6 } } } } } }
            env: { t: 7 }, hostoptions: { t: 8 }, loadoptions: { t: 9 } }
      out: { t: 9 } }
  ]


  # Levels 3-6 are ONE ordered merge, and the order is the point (§9.3):
  # PROFILE SPECIFICITY OUTRANKS DEFINITION SPECIFICITY.
  optprofile: set: [
    {
      id: 'config/optprofile#specificity', doc: true
      in: { ref: 'stripe$test', profile: 'prod'
            doc: { instance: { 'stripe$test': { options: { t: 'base-instance' } } }
                   profile: { prod: { default: { stripe: { options: { t: 'prod-default' } } } } } } }
      out: { t: 'prod-default' }
    }
    # Within one profile the instance beats the definition default —
    # that is what an instance is for.
    {
      in: { ref: 'stripe$test', profile: 'prod'
            doc: { profile: { prod: { default: { stripe: { options: { t: 'prod-default' } } }
                                      instance: { 'stripe$test': { options: { t: 'prod-instance' } } } } } } }
      out: { t: 'prod-instance' }
    }
    {
      in: { ref: 'r', profile: 'p'
            doc: { instance: { r: { options: { a: 1, b: 1 } } }
                   profile: { p: { instance: { r: { options: { b: 2 } } } } } } }
      out: { a: 1, b: 2 }
    }
    {
      in: { ref: 'r'
            doc: { instance: { r: { options: { t: 1 } } }
                   profile: { p: { instance: { r: { options: { t: 99 } } } } } } }
      out: { t: 1 }
    }
  ]


  optdefault: set: [
    {
      id: 'config/optdefault#byname', doc: true
      in: { ref: 'stripe$eu', doc: { default: { stripe: { options: { t: 5000 } } } } }
      out: { t: 5000 }
    }
    { in: { ref: 'stripe$test', doc: { default: { stripe: { options: { t: 5000 } } } } }, out: { t: 5000 } }
    { in: { ref: 'stripe', doc: { default: { stripe: { options: { t: 5000 } } } } }, out: { t: 5000 } }
    { in: { ref: 'other', doc: { default: { stripe: { options: { t: 5000 } } } } }, out: {} }

    {
      in: { ref: 'stripe', doc: { default: { stripe: { options: { a: 'from-default', b: 1 } } }
                                  instance: { stripe: { options: { a: 'from-instance' } } } } }
      out: { a: 'from-instance', b: 1 }
    }
    # And the untagged instance's options apply ONLY to itself — this is
    # what replaced seneca's shortname rule, so a tagged sibling sees the
    # `default` value and not the untagged instance's.
    {
      in: { ref: 'stripe$test', doc: { default: { stripe: { options: { a: 'from-default' } } }
                                       instance: { stripe: { options: { a: 'from-untagged' } } } } }
      out: { a: 'from-default' }
    }
  ]


  optlist: set: [
    {
      id: 'config/optlist#replace', doc: true
      in: { ref: 'r', doc: { default: { r: { options: { p: ['x', 'y', 'z'] } } }
                             instance: { r: { options: { p: ['a'] } } } } }
      out: { p: ['a'] }
    }
    { in: { ref: 'r', doc: { instance: { r: { options: { p: ['x', 'y'] } } } }, patch: { p: [] } }, out: { p: [] } }
    {
      in: { ref: 'r', doc: { default: { r: { options: { p: ['x'], m: { a: 1 } } } }
                             instance: { r: { options: { p: ['a'], m: { b: 2 } } } } } }
      out: { p: ['a'], m: { a: 1, b: 2 } }
    }
  ]


  # The option SHAPE declares each key's merge behaviour (§9.4). The
  # library default is deep for maps and replace for lists; the shape is
  # the one place the question is answered, and it travels with the
  # definition rather than living as a table in the host.
  optmerge: set: [
    {
      id: 'config/optmerge#replace', doc: true
      in: { ref: 'r', shape: { policy: { '$MERGE': 'replace' } }
            doc: { default: { r: { options: { policy: { hosts: ['a.example'], strict: true } } } }
                   instance: { r: { options: { policy: { hosts: ['b.example'] } } } } } }
      out: { policy: { hosts: ['b.example'] } }
    }
    {
      in: { ref: 'r', shape: { p: { '$MERGE': 'append' } }
            doc: { default: { r: { options: { p: ['x'] } } }
                   instance: { r: { options: { p: ['y'] } } } } }
      out: { p: ['x', 'y'] }
    }
    # deep: N — merge N levels below the key, replace below that.
    # Station's `feature` needs exactly deep:2 — by feature name, then by
    # option key, replacing below. Here `headers` (level 3) replaces
    # wholesale while `retry`'s other keys survive.
    {
      id: 'config/optmerge#deep2'
      in: { ref: 'r', shape: { feature: { '$MERGE': { deep: 2 } } }
            doc: { default: { r: { options: { feature: { retry: { n: 3, headers: { a: 1, b: 2 } } } } } }
                   instance: { r: { options: { feature: { retry: { headers: { c: 3 } } } } } } } }
      out: { feature: { retry: { n: 3, headers: { c: 3 } } } }
    }
    {
      in: { ref: 'r', shape: { m: { '$MERGE': { deep: 1 } } }
            doc: { default: { r: { options: { m: { a: { x: 1 }, b: 2 } } } }
                   instance: { r: { options: { m: { a: { y: 2 } } } } } } }
      out: { m: { a: { y: 2 }, b: 2 } }
    }
    # A definition that says nothing gets deep-for-maps and never learns
    # the key exists.
    {
      in: { ref: 'r', doc: { default: { r: { options: { m: { a: { x: 1 }, b: 2 } } } }
                             instance: { r: { options: { m: { a: { y: 2 } } } } } } }
      out: { m: { a: { x: 1, y: 2 }, b: 2 } }
    }

    {
      id: 'config/optmerge#replace-at-patch'
      in: { ref: 'r', shape: { policy: { '$MERGE': 'replace' } }
            doc: { instance: { r: { options: { policy: { hosts: ['a.example'], strict: true } } } } }
            patch: { policy: { hosts: ['b.example'] } } }
      out: { policy: { hosts: ['b.example'] } }
    }
    { in: { ref: 'r', shape: { policy: { '$MERGE': 'replace' } }
            doc: { instance: { r: { options: { policy: { hosts: ['a.example'], strict: true } } } } }
            env: { policy: { hosts: ['b.example'] } } }
      out: { policy: { hosts: ['b.example'] } } }
    { in: { ref: 'r', shape: { policy: { '$MERGE': 'replace' } }
            doc: { instance: { r: { options: { policy: { hosts: ['a.example'], strict: true } } } } }
            hostoptions: { policy: { hosts: ['b.example'] } } }
      out: { policy: { hosts: ['b.example'] } } }
    { in: { ref: 'r', shape: { policy: { '$MERGE': 'replace' } }
            doc: { instance: { r: { options: { policy: { hosts: ['a.example'], strict: true } } } } }
            loadoptions: { policy: { hosts: ['b.example'] } } }
      out: { policy: { hosts: ['b.example'] } } }
    # append across the upper layers too — a port special-casing the
    # document merge would concatenate there and overwrite here.
    { in: { ref: 'r', shape: { p: { '$MERGE': 'append' } }
            doc: { instance: { r: { options: { p: ['x'] } } } }
            patch: { p: ['y'] } }
      out: { p: ['x', 'y'] } }
    { in: { ref: 'r', shape: { feature: { '$MERGE': { deep: 2 } } }
            doc: { instance: { r: { options: { feature: { retry: { n: 3, headers: { a: 1 } } } } } } }
            patch: { feature: { retry: { headers: { c: 3 } } } } }
      out: { feature: { retry: { n: 3, headers: { c: 3 } } } } }
    { in: { ref: 'r', doc: { instance: { r: { options: { p: ['x', 'y', 'z'] } } } }
            patch: { p: ['a'] } }
      out: { p: ['a'] } }
  ]


  optmergebad: set: [
    { id: 'config/optmergebad#zero', doc: true
      in: { ref: 'r', shape: { m: { '$MERGE': { deep: 0 } } } }, err: true, match: { err: { code: 'plugin_shape_invalid' } } }
    { in: { ref: 'r', shape: { m: { '$MERGE': { deep: -1 } } } }, err: true, match: { err: { code: 'plugin_shape_invalid' } } }
    { in: { ref: 'r', shape: { m: { '$MERGE': { deep: 1.5 } } } }, err: true, match: { err: { code: 'plugin_shape_invalid' } } }
    { in: { ref: 'r', shape: { m: { '$MERGE': { deep: 'two' } } } }, err: true, match: { err: { code: 'plugin_shape_invalid' } } }
    { in: { ref: 'r', shape: { m: { '$MERGE': { deep: null } } } }, err: true, match: { err: { code: 'plugin_shape_invalid' } } }
    { in: { ref: 'r', shape: { m: { '$MERGE': 'merge' } } }, err: true, match: { err: { code: 'plugin_shape_invalid' } } }
    { in: { ref: 'r', shape: { m: { '$MERGE': 'REPLACE' } } }, err: true, match: { err: { code: 'plugin_shape_invalid' } } }
    { in: { ref: 'r', shape: { m: { '$MERGE': true } } }, err: true, match: { err: { code: 'plugin_shape_invalid' } } }
    { in: { ref: 'r', shape: { m: { '$MERGE': {} } } }, err: true, match: { err: { code: 'plugin_shape_invalid' } } }
    { id: 'config/optmergebad#names-key'
      in: { ref: 'r', shape: { m: { '$MERGE': { deep: 0 } } } }
      err: true, match: { err: { message: '/m/' } } }
    { id: 'config/optmergebad#names-directive'
      in: { ref: 'r', shape: { m: { '$MERGE': { deep: 0 } } } }
      err: true, match: { err: { message: '/\\$MERGE/' } } }
  ]
}



primary: lifecycle: {

  # The forward path. Each step implies the ones before it (§5.1), so
  # `activate` on an undeclared ref declares and loads on the way.
  forward: set: [
    {
      id: 'lifecycle/forward#full', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'load', ref: 'probe$a' }
        { do: 'activate', ref: 'probe$a' }
      ]
      out: { status: { 'probe$a': 'live' }, open: 1, log: ['probe$a:define', 'probe$a:activate'], result: null }
    }
    # `load` stops at loaded: configured, stateful, INERT. No resource is
    # held, because capture belongs to activation and nowhere else.
    {
      in: [ { do: 'define', name: 'probe' }, { do: 'load', ref: 'probe$a' } ]
      out: { status: { 'probe$a': 'loaded' }, open: 0, log: ['probe$a:define'], result: null }
    }
    {
      in: [ { do: 'define', name: 'probe' }, { do: 'ready', ref: 'probe$a' } ]
      match: { out: { status: { 'probe$a': 'live' }, open: 1 } }
    }
  ]


  # The backward path. Plugin state survives every backward step except
  # unload; the resource does not survive deactivate.
  back: set: [
    {
      id: 'lifecycle/back#deactivate', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'deactivate', ref: 'probe$a' }
      ]
      out: { status: { 'probe$a': 'loaded' }, open: 0
             log: ['probe$a:define', 'probe$a:activate', 'probe$a:deactivate'], result: null }
    }
    # unload runs close and removes the entry entirely — an absent
    # instance is ABSENT from status, not present with a null status.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'unload', ref: 'probe$a' }
      ]
      out: { status: {}, open: 0
             log: ['probe$a:define', 'probe$a:activate', 'probe$a:deactivate', 'probe$a:close'], result: null }
    }
    # unload from `live` deactivates first, then closes (§5.2's table) —
    # the log proves the order rather than just the end state.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'unload', ref: 'probe$a' }
      ]
      match: { out: { log: ['probe$a:define', 'probe$a:activate', 'probe$a:deactivate', 'probe$a:close'] } }
    }
  ]


  # IDEMPOTENT IN THE TRIVIAL DIRECTION (§5.2). activate on a live
  # instance is a no-op returning success, not an error. This is what
  # lets declarative config be applied repeatedly (§9.6) without the host
  # tracking what it already did — and the log is the proof that it is a
  # no-op rather than a repeat: `activate` fires ONCE.
  idem: set: [
    {
      id: 'lifecycle/idem#activate', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'activate', ref: 'probe$a' }
        { do: 'activate', ref: 'probe$a' }
      ]
      out: { status: { 'probe$a': 'live' }, open: 1
             log: ['probe$a:define', 'probe$a:activate'], result: null }
    }
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'load', ref: 'probe$a' }
        { do: 'load', ref: 'probe$a' }
      ]
      out: { status: { 'probe$a': 'loaded' }, open: 0, log: ['probe$a:define'], result: null }
    }
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'load', ref: 'probe$a' }
        { do: 'deactivate', ref: 'probe$a' }
      ]
      out: { status: { 'probe$a': 'loaded' }, open: 0, log: ['probe$a:define'], result: null }
    }
  ]


  # DEACTIVATING A `pending` INSTANCE RUNS NO CALLBACK (§5.2). It never
  # reached activate, so it holds no scope and no live bindings; running
  # the definition's deactivate there would be teardown without matching
  # setup, which plugins are not written to survive and which could fail
  # an instance that had done nothing wrong.
  pending: set: [
    {
      id: 'lifecycle/pending#unmet', doc: true
      in: [
        { do: 'define', name: 'dep' }
        { do: 'load', ref: 'dep$a', options: { requires: ['missing'] } }
        { do: 'activate', ref: 'dep$a' }
      ]
      out: { status: { 'dep$a': 'pending' }, open: 0, log: ['dep$a:define'], result: null }
    }
    # The withdrawal is callback-free and CANNOT FAIL: no `deactivate` in
    # the log, and the instance lands back at `loaded`.
    {
      in: [
        { do: 'define', name: 'dep' }
        { do: 'load', ref: 'dep$a', options: { requires: ['missing'] } }
        { do: 'activate', ref: 'dep$a' }
        { do: 'deactivate', ref: 'dep$a' }
      ]
      out: { status: { 'dep$a': 'loaded' }, open: 0, log: ['dep$a:define'], result: null }
    }
    # `pending` is observably identical to `loaded` — nothing held,
    # nothing bound — but it is a STATE and not a flag, because it means
    # something entirely different to whoever reads the status map.
    {
      in: [
        { do: 'define', name: 'dep' }
        { do: 'load', ref: 'dep$a', options: { requires: ['missing'] } }
        { do: 'activate', ref: 'dep$a' }
      ]
      match: { out: { status: { 'dep$a': 'pending' }, open: 0 } }
    }
  ]


  # ANY failure during a transition lands the instance in `failed` (§5.2).
  # There is no second, softer failure state: the point of `failed` is
  # that it is not trustworthy.
  fail: set: [
    {
      id: 'lifecycle/fail#activate', doc: true
      in: [
        { do: 'define', name: 'noisy', probe: 'noisy' }
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate', code: 'probe_boom' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
      ]
      match: { out: { status: { 'noisy$a': 'failed' } } }
    }
    {
      in: [
        { do: 'define', name: 'noisy', probe: 'noisy' }
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate', code: 'probe_boom' } }
        { do: 'activate', ref: 'noisy$a' }
      ]
      err: true, match: { err: { code: 'probe_boom' } }
    }
    # A failed instance remains REGISTERED AND INSPECTABLE — that is the
    # point: a failed plugin must be visible, not vanished.
    {
      in: [
        { do: 'define', name: 'noisy', probe: 'noisy' }
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
        { do: 'list' }
      ]
      match: { out: { result: { 'noisy$a': 'failed' } } }
    }
    {
      in: [
        { do: 'define', name: 'noisy', probe: 'noisy' }
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
        { do: 'activate', ref: 'noisy$a' }
      ]
      err: true, match: { err: { code: 'plugin_bad_state' } }
    }
    {
      in: [
        { do: 'define', name: 'noisy', probe: 'noisy' }
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
        { do: 'unload', ref: 'noisy$a' }
      ]
      match: { out: { status: {} } }
    }
    # Bindings are ALWAYS removed before the status changes, so a failed
    # instance never participates in anything, whatever went wrong.
    {
      in: [
        { do: 'define', name: 'noisy', probe: 'noisy' }
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: [] } }
    }
    # A failing activate must not leak the resource it had acquired: the
    # instance scope unwinds in reverse on partial activation (§8.3).
    # The probe acquires BEFORE it raises, so a port that unwinds only
    # on a clean path leaves this at 1.
    {
      in: [
        { do: 'define', name: 'noisy', probe: 'noisy' }
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
      ]
      match: { out: { open: 0 } }
    }
  ]


  faildown: set: [
    {
      id: 'lifecycle/faildown#deactivate', doc: true
      in: [
        { do: 'ready', ref: 'noisy$a', options: { fail: 'deactivate' } }
        { do: 'deactivate', ref: 'noisy$a', catch: true }
      ]
      match: { out: { status: { 'noisy$a': 'failed' }, open: 0 } }
    }
    {
      in: [
        { do: 'ready', ref: 'noisy$a', options: { fail: 'deactivate', code: 'probe_boom' } }
        { do: 'deactivate', ref: 'noisy$a' }
      ]
      err: true, match: { err: { code: 'probe_boom' } }
    }
    {
      id: 'lifecycle/faildown#unload'
      in: [
        { do: 'ready', ref: 'noisy$a', options: { fail: 'deactivate' } }
        { do: 'unload', ref: 'noisy$a', catch: true }
      ]
      match: { out: { status: { 'noisy$a': 'failed' }, open: 0 } }
    }
    # A second unload then takes it out through the `failed` row, which
    # runs `close` and drops the entry.
    {
      in: [
        { do: 'ready', ref: 'noisy$a', options: { fail: 'deactivate' } }
        { do: 'unload', ref: 'noisy$a', catch: true }
        { do: 'unload', ref: 'noisy$a' }
      ]
      match: { out: { status: {}, open: 0 } }
    }
    # A failing `close` still DROPS the registry entry — §5.2's `unload`
    # row says the error is raised and the entry goes anyway, which is
    # the one place a failure leaves nothing behind.
    {
      id: 'lifecycle/faildown#close-drops'
      in: [
        { do: 'ready', ref: 'noisy$a', options: { fail: 'close' } }
        { do: 'unload', ref: 'noisy$a', catch: true }
        { do: 'list' }
      ]
      match: { out: { result: {}, open: 0 } }
    }
  ]


  slow: set: [
    {
      id: 'lifecycle/slow#is-a-probe', doc: true
      in: [
        { do: 'ready', ref: 'slow$a' }
        { do: 'deactivate', ref: 'slow$a' }
        { do: 'unload', ref: 'slow$a' }
      ]
      out: {
        status: {}
        open: 0
        result: null
        log: ['slow$a:define', 'slow$a:activate', 'slow$a:deactivate', 'slow$a:close']
      }
    }
    # ...and it settles EAGERLY: `ready` returns with the instance live
    # and its resource held, in the same synchronous call.
    {
      in: [ { do: 'ready', ref: 'slow$a' } ]
      match: { out: { status: { 'slow$a': 'live' }, open: 1 } }
    }
  ]

  wrap: set: [
    {
      id: 'lifecycle/wrap#bare-activate', doc: true
      in: [
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate', bare: true } }
        { do: 'activate', ref: 'noisy$a' }
      ]
      err: true, match: { err: { code: 'plugin_activate_failed' } }
    }
    {
      in: [ { do: 'load', ref: 'noisy$a', options: { fail: 'define', bare: true } } ]
      err: true, match: { err: { code: 'plugin_define_failed' } }
    }
    {
      in: [
        { do: 'ready', ref: 'noisy$a', options: { fail: 'deactivate', bare: true } }
        { do: 'deactivate', ref: 'noisy$a' }
      ]
      err: true, match: { err: { code: 'plugin_deactivate_failed' } }
    }
    {
      in: [
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate', bare: true } }
        { do: 'activate', ref: 'noisy$a', catch: true }
      ]
      match: { out: { status: { 'noisy$a': 'failed' }, open: 0 } }
    }
    {
      id: 'lifecycle/wrap#own-code-kept'
      in: [
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate', code: 'store_unreachable' } }
        { do: 'activate', ref: 'noisy$a' }
      ]
      err: true, match: { err: { code: 'store_unreachable' } }
    }
  ]


  failedexit: set: [
    {
      id: 'lifecycle/failedexit#deactivate', doc: true
      in: [
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
        { do: 'deactivate', ref: 'noisy$a' }
      ]
      err: true, match: { err: { code: 'plugin_bad_state' } }
    }
    {
      in: [
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
        { do: 'deactivate', ref: 'noisy$a', catch: true }
        { do: 'list' }
      ]
      match: { out: { result: { 'noisy$a': 'failed' } } }
    }
  ]


  # Illegal transitions raise rather than silently no-op. The idempotent
  # cases above are the ONLY exceptions, and they are pinned there rather
  # than left to the reader.
  illegal: set: [
    { id: 'lifecycle/illegal#activate-absent', doc: true
      in: [ { do: 'activate', ref: 'nope$a' } ], err: true, match: { err: { code: 'plugin_not_loaded' } } }
    { in: [ { do: 'deactivate', ref: 'nope$a' } ], err: true, match: { err: { code: 'plugin_not_loaded' } } }
    { in: [ { do: 'unload', ref: 'nope$a' } ], err: true, match: { err: { code: 'plugin_not_loaded' } } }
    { in: [ { do: 'options', ref: 'nope$a', patch: {} } ], err: true, match: { err: { code: 'plugin_not_loaded' } } }
    # A load onto an OCCUPIED ref is plugin_ref_duplicate (§4 rule 1) —
    # not a silent overwrite as in seneca, and not an impossibility as in
    # sdkgen. Note this is `load` twice, which the idem group shows is a
    # no-op; the duplicate is a SECOND DEFINITION claiming a taken ref.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'define', name: 'other' }
        { do: 'load', ref: 'probe$a' }
        { do: 'load', ref: 'probe$a', definition: 'other' }
      ]
      err: true, match: { err: { code: 'plugin_ref_duplicate' } }
    }
    { in: [ { do: 'load', ref: 'nosuch$a' } ], err: true, match: { err: { code: 'plugin_unknown_definition' } } }
  ]


  introspect: set: [
    {
      id: 'lifecycle/introspect#free', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { start: 'lazy' } } } }
        { do: 'list' }
      ]
      out: { status: { 'probe$a': 'declared' }, open: 0, log: []
             result: { 'probe$a': 'declared' } }
    }
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { start: 'lazy' }, 'probe$b': { start: 'lazy' } } } }
      ]
      out: { status: { 'probe$a': 'declared', 'probe$b': 'declared' }, open: 0, log: [], result: null }
    }
  ]


  # TRANSITIONS ARE SEQUENTIAL (§5.2). A transition triggered from inside
  # a lifecycle callback is plugin_reentrant. A hard rule, because it is
  # the only way the semantics can be identical in Go, in Ruby and in
  # single-threaded JavaScript.
  reentrant: set: [
    {
      id: 'lifecycle/reentrant#activate', doc: true
      in: [
        { do: 'define', name: 'noisy', probe: 'noisy' }
        { do: 'load', ref: 'noisy$a', options: { reenter: 'activate' } }
        { do: 'activate', ref: 'noisy$a' }
      ]
      err: true, match: { err: { code: 'plugin_reentrant' } }
    }
  ]


  bindscope: set: [
    {
      id: 'lifecycle/bindscope#activate', doc: true
      in: [
        { do: 'load', ref: 'greedy$a', options: { bind: 'activate' } }
        { do: 'activate', ref: 'greedy$a' }
      ]
      err: true, match: { err: { code: 'plugin_bind_scope' } }
    }
    # ...and from `deactivate` too. The guard is on the PHASE, not on
    # "not define", and an entry exercising only one callback leaves the
    # other's mutation alive.
    {
      in: [
        { do: 'ready', ref: 'greedy$a', options: { bind: 'deactivate' } }
        { do: 'deactivate', ref: 'greedy$a' }
      ]
      err: true, match: { err: { code: 'plugin_bind_scope' } }
    }
    # ...and the failure lands the instance in `failed` like any other
    # callback raise, with nothing left behind.
    {
      in: [
        { do: 'load', ref: 'greedy$a', options: { bind: 'activate' } }
        { do: 'activate', ref: 'greedy$a', catch: true }
      ]
      match: { out: { status: { 'greedy$a': 'failed' }, open: 0 } }
    }
  ]

  resource: set: [
    {
      id: 'lifecycle/resource#unwind', doc: true
      in: [
        { do: 'define', name: 'greedy', probe: 'greedy' }
        { do: 'load', ref: 'greedy$a', options: { acquire: 3, release: 1 } }
        { do: 'activate', ref: 'greedy$a' }
      ]
      match: { out: { open: 2 } }
    }
    # Deactivation unwinds the rest — the instance scope, not a ledger
    # the plugin has to remember to keep.
    {
      in: [
        { do: 'define', name: 'greedy', probe: 'greedy' }
        { do: 'load', ref: 'greedy$a', options: { acquire: 3, release: 1 } }
        { do: 'activate', ref: 'greedy$a' }
        { do: 'deactivate', ref: 'greedy$a' }
      ]
      match: { out: { open: 0 } }
    }
    # State survives the cycle unchanged (§5.4): deactivating a rate
    # limiter and reactivating it must not reset its counters. Pinned
    # through the probe's COUNTER rather than object identity, so a port
    # whose language has no stable identity is not failed for it.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'bump' }
        { do: 'call', ref: 'probe$a', method: 'bump' }
        { do: 'deactivate', ref: 'probe$a' }
        { do: 'activate', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'count' }
      ]
      match: { out: { result: 2 } }
    }
    # unload destroys it — going back to absent means "as if never
    # loaded", and close is what properly undoes `define`.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'bump' }
        { do: 'unload', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'count' }
      ]
      match: { out: { result: 0 } }
    }
  ]
}



primary: order: {

  constraint: set: [
    {
      id: 'order/constraint#after', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b', order: { after: 'probe$a' } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'probe$b'] } }
    }
    # `before` is the mirror, and must not be implemented as "after,
    # reversed" — a port that does gets this one backwards.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b', order: { before: 'probe$a' } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$b', 'probe$a'] } }
    }
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'define', name: 'late' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b' }
        { do: 'ready', ref: 'late$x', definition: 'late', order: { after: 'probe' } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'probe$b', 'late$x'] } }
    }
    # By REF orders behind exactly one, so the other instance is free to
    # sort ahead of the constrained binding.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'define', name: 'late' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'late$x', definition: 'late', order: { after: 'probe$a' } }
        { do: 'ready', ref: 'probe$b' }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'late$x', 'probe$b'] } }
    }
  ]


  # Bands break constraint-free ordering GLOBALLY — what lets a host say
  # "the base transport wrapper is band 100" once, instead of every
  # plugin naming it. Lower runs first: outermost for a chain, first for
  # a hook.
  band: set: [
    {
      id: 'order/band#lower-first', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { band: 10 } }
        { do: 'ready', ref: 'probe$b', order: { band: 1 } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$b', 'probe$a'] } }
    }
    # Default band is 0, so an unbanded binding sorts ahead of band 1 —
    # a port defaulting to 1, or to "no band", gets this backwards.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { band: 1 } }
        { do: 'ready', ref: 'probe$b' }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$b', 'probe$a'] } }
    }
    # Negative bands are ordinary integers, not an error: a host adding a
    # layer BELOW an existing one should not have to renumber.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b', order: { band: -5 } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$b', 'probe$a'] } }
    }
  ]


  # CONSTRAINTS BEAT BANDS (§7), precisely so that the correct tool wins
  # when both are present. A band chosen by trial and error to fix an
  # ordering bug is a bug wearing a number; a constraint says what was
  # actually meant, so it must not lose to one.
  precedence: set: [
    {
      id: 'order/precedence#constraint-wins', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { band: 99 } }
        { do: 'ready', ref: 'probe$b', order: { band: 1, after: 'probe$a' } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'probe$b'] } }
    }
  ]


  list: set: [
    {
      id: 'order/list#after-one', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { band: 99 } }
        { do: 'ready', ref: 'probe$b', order: { band: 1, after: ['probe$a'] } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'probe$b'] } }
    }
    {
      id: 'order/list#after-many', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { band: 99 } }
        { do: 'ready', ref: 'probe$c', order: { band: 99 } }
        { do: 'ready', ref: 'probe$b', order: { band: 1, after: ['probe$a', 'probe$c'] } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'probe$c', 'probe$b'] } }
    }
    {
      id: 'order/list#before-many', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { band: 99, before: ['probe$b', 'probe$c'] } }
        { do: 'ready', ref: 'probe$b', order: { band: 1 } }
        { do: 'ready', ref: 'probe$c', order: { band: 1 } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'probe$b', 'probe$c'] } }
    }
    # An EMPTY list declares no constraint. It must not be read as one -
    # and a truthiness test gets this wrong in every language where an
    # empty array is truthy, which is most of them.
    {
      id: 'order/list#empty-is-no-constraint', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { band: 99 } }
        { do: 'ready', ref: 'probe$b', order: { band: 1, after: [] } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$b', 'probe$a'] } }
    }
    {
      id: 'order/list#name-and-ref-are-one-edge', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'define', name: 'other' }
        { do: 'ready', ref: 'probe$a', order: { band: 99 } }
        { do: 'ready', ref: 'other$b', order: { band: 1, after: ['probe', 'probe$a'] } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'other$b'] } }
    }
    # A vacuous member does not poison the rest: an absent name is
    # satisfied vacuously (§7) and the real constraint still holds.
    {
      id: 'order/list#vacuous-member', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { band: 99 } }
        { do: 'ready', ref: 'probe$b', order: { band: 1, after: ['nosuchthing', 'probe$a'] } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'probe$b'] } }
    }
  ]


  seqtie: set: [
    {
      id: 'order/seqtie#shared-pos', doc: true
      in: [
        { do: 'ready', ref: 'probe$z' }
        { do: 'ready', ref: 'probe$b' }
        { do: 'unload', ref: 'probe$z' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$b', 'probe$a'] } }
    }
  ]

  tie: set: [
    {
      id: 'order/tie#pos', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'apply', doc: { plugin: 1, instance: [
            { ref: 'probe$first' }, { ref: 'probe$second' }, { ref: 'probe$third' } ] } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$first', 'probe$second', 'probe$third'] } }
    }
    # LOAD ORDER IS NOT `pos`. With lazy instances, twenty declared in
    # document order may load in whatever order their first ready() calls
    # arrive — and the document's order is the one that must decide.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'apply', doc: { plugin: 1, instance: [
            { ref: 'probe$first', start: 'lazy' }
            { ref: 'probe$second', start: 'lazy' }
            { ref: 'probe$third', start: 'lazy' } ] } }
        { do: 'ready', ref: 'probe$third' }
        { do: 'ready', ref: 'probe$first' }
        { do: 'ready', ref: 'probe$second' }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$first', 'probe$second', 'probe$third'] } }
    }
    # `seq` IS NOT `pos` EITHER. A re-applied document that toggles an
    # early instance gives it a fresh seq; a counter-based tie-break
    # would sort it behind everything that never moved, silently
    # reordering a chain. `pos` is stable across the redeclaration.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'apply', doc: { plugin: 1, instance: [
            { ref: 'probe$first' }, { ref: 'probe$second' }, { ref: 'probe$third' } ] } }
        { do: 'apply', doc: { plugin: 1, instance: [
            { ref: 'probe$first', active: false }, { ref: 'probe$second' }, { ref: 'probe$third' } ] } }
        { do: 'apply', doc: { plugin: 1, instance: [
            { ref: 'probe$first' }, { ref: 'probe$second' }, { ref: 'probe$third' } ] } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$first', 'probe$second', 'probe$third'] } }
    }
    # In the map form, `pos` is the SORTED-ref index, so the tie-break is
    # byte-stable rather than dependent on the parser's key order.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$c': {}, 'probe$a': {}, 'probe$b': {} } } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'probe$b', 'probe$c'] } }
    }
  ]


  # A CONSTRAINT AGAINST AN ABSENT BINDING IS SATISFIED VACUOUSLY (§7) —
  # not an error. A plugin ordered `after: 'test'` must load in a host
  # with no test plugin. This is sdkgen's __after__ behaviour, kept.
  vacuous: set: [
    {
      id: 'order/vacuous#absent', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { after: 'nosuchthing' } }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a'] } }
    }
    # A constraint against a DEACTIVATED instance is the same case: the
    # binding is not in the live set, so the edge is vacuous rather than
    # blocking.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b', order: { after: 'probe$a' } }
        { do: 'deactivate', ref: 'probe$a' }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$b'] } }
    }
  ]


  # THE ORDER IS RECOMPUTED ON ANY CHANGE TO THE LIVE SET (§7) — it is
  # not computed once at startup and cached, which is the bug a host
  # discovers only when something deactivates in production.
  recompute: set: [
    {
      id: 'order/recompute#reactivate', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b', order: { after: 'probe$a' } }
        { do: 'deactivate', ref: 'probe$a' }
        { do: 'activate', ref: 'probe$a' }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'probe$b'] } }
    }
    {
      in: [ { do: 'define', name: 'probe' }, { do: 'order', point: 'p' } ]
      match: { out: { result: [] } }
    }
  ]


  # A cycle is plugin_order_cycle, REPORTED WITH THE CYCLE (§7) — a bare
  # "cycle detected" leaves the author bisecting a twenty-plugin host.
  cycle: set: [
    {
      id: 'order/cycle#pair', doc: true
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { after: 'probe$b' } }
        { do: 'ready', ref: 'probe$b', order: { after: 'probe$a' } }
        { do: 'order', point: 'p' }
      ]
      err: true, match: { err: { code: 'plugin_order_cycle' } }
    }
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { after: 'probe$c' } }
        { do: 'ready', ref: 'probe$b', order: { after: 'probe$a' } }
        { do: 'ready', ref: 'probe$c', order: { after: 'probe$b' } }
        { do: 'order', point: 'p' }
      ]
      err: true, match: { err: { code: 'plugin_order_cycle' } }
    }
    # A self-edge is a cycle of one, and must not be silently dropped.
    {
      in: [
        { do: 'define', name: 'probe' }
        { do: 'ready', ref: 'probe$a', order: { after: 'probe$a' } }
        { do: 'order', point: 'p' }
      ]
      err: true, match: { err: { code: 'plugin_order_cycle' } }
    }
  ]


  pinorder: set: [
    {
      id: 'order/pinorder#two-names', doc: true
      in: [
        { do: 'host', points: { p: { kind: 'hook', pin: { noisy: 'first', probe: 'first' } } } }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'noisy$b' }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a', 'noisy$b'] } }
    }
  ]

  pin: set: [
    {
      id: 'order/pin#innermost', doc: true
      in: [
        { do: 'host', points: { c: { kind: 'chain', pin: { adapter: 'innermost' } } } }
        { do: 'define', name: 'probe' }
        { do: 'define', name: 'adapter' }
        { do: 'ready', ref: 'adapter$x', definition: 'adapter' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'order', point: 'c' }
      ]
      match: { out: { result: ['probe$a', 'adapter$x'] } }
    }
    # An ordering that would move the pinned binding is an ERROR, not a
    # preference honoured into a broken wrap. Station's adapter must sit
    # immediately outside the base transport; an `order` list that moves
    # it has to fail.
    {
      in: [
        { do: 'host', points: { c: { kind: 'chain', pin: { adapter: 'innermost' } } } }
        { do: 'define', name: 'probe' }
        { do: 'define', name: 'adapter' }
        { do: 'ready', ref: 'adapter$x', definition: 'adapter' }
        { do: 'ready', ref: 'probe$a', order: { after: 'adapter$x' } }
        { do: 'order', point: 'c' }
      ]
      err: true, match: { err: { code: 'plugin_order_pinned' } }
    }
    # `outermost` is the other end, and a hook's vocabulary is
    # first/last — the same mechanism, named for the shape it applies to.
    {
      in: [
        { do: 'host', points: { c: { kind: 'chain', pin: { adapter: 'outermost' } } } }
        { do: 'define', name: 'probe' }
        { do: 'define', name: 'adapter' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'adapter$x', definition: 'adapter' }
        { do: 'order', point: 'c' }
      ]
      match: { out: { result: ['adapter$x', 'probe$a'] } }
    }
  ]
}



primary: env: {

  option: set: [
    {
      id: 'env/option#simple', doc: true
      in: { refs: ['retry'], env: { VOXGIG_PLUGIN_RETRY_RETRIES: '3' } }
      out: { options: { retry: { retries: 3 } }, active: [], inactive: [] }
    }
    {
      in: { refs: ['retry$fast'], env: { VOXGIG_PLUGIN_RETRY__FAST_RETRIES: '3' } }
      match: { out: { options: { 'retry$fast': { retries: 3 } } } }
    }
    {
      in: { refs: ['retry'], env: { VOXGIG_PLUGIN_RETRY_MIN_DELAY: '500' } }
      match: { out: { options: { retry: { min: { delay: 500 } } } } }
    }
    {
      id: 'env/option#longest'
      in: { refs: ['retry', 'retry$fast'], env: { VOXGIG_PLUGIN_RETRY__FAST_MIN: '1' } }
      match: { out: { options: { 'retry$fast': { min: 1 } } } }
    }
    # A key for a ref this host does not hold is IGNORED, not an error:
    # one environment commonly serves several hosts.
    {
      in: { refs: ['retry'], env: { VOXGIG_PLUGIN_OTHER_X: '1' } }
      out: { options: {}, active: [], inactive: [] }
    }
    {
      in: { refs: ['retry'], env: { PATH: '/usr/bin', HOME: '/root' } }
      out: { options: {}, active: [], inactive: [] }
    }
  ]


  # VALUES PARSE AS JSON, FALLING BACK TO STRING (§9.5). A port that
  # treats every value as a string produces `"8080"` where a shape wants
  # a number, and one that requires valid JSON rejects `hello`.
  value: set: [
    { id: 'env/value#number', doc: true
      in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_N: '8080' } }
      match: { out: { options: { r: { n: 8080 } } } } }
    { in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_B: 'true' } }
      match: { out: { options: { r: { b: true } } } } }
    { in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_B: 'false' } }
      match: { out: { options: { r: { b: false } } } } }
    { in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_S: 'hello' } }
      match: { out: { options: { r: { s: 'hello' } } } } }
    { in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_M: '{"a":1}' } }
      match: { out: { options: { r: { m: { a: 1 } } } } } }
    { in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_L: '[1,2]' } }
      match: { out: { options: { r: { l: [1, 2] } } } } }
    { in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_N: 'null' } }
      match: { out: { options: { r: { n: '__NULL__' } } } } }

    { id: 'env/value#not-json-constants'
      in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_N: 'NaN' } }
      match: { out: { options: { r: { n: 'NaN' } } } } }
    { in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_N: 'Infinity' } }
      match: { out: { options: { r: { n: 'Infinity' } } } } }
    { in: { refs: ['r'], env: { VOXGIG_PLUGIN_R_N: '-Infinity' } }
      match: { out: { options: { r: { n: '-Infinity' } } } } }
  ]


  # ACTIVE / INACTIVE — the "turn it off in production without a deploy"
  # lever, and the one thing an operator reaches for first.
  toggle: set: [
    { id: 'env/toggle#active', doc: true
      in: { refs: ['a', 'b'], env: { VOXGIG_PLUGIN_ACTIVE: 'a,b' } }
      match: { out: { active: ['a', 'b'] } } }
    { in: { refs: ['a'], env: { VOXGIG_PLUGIN_INACTIVE: 'a' } }
      match: { out: { inactive: ['a'] } } }
    { in: { refs: ['a', 'b'], env: { VOXGIG_PLUGIN_ACTIVE: ' a , b ' } }
      match: { out: { active: ['a', 'b'] } } }
    { in: { refs: ['a'], env: { VOXGIG_PLUGIN_INACTIVE: 'a$' } }
      match: { out: { inactive: ['a'] } } }
    { in: { refs: ['a'], env: { VOXGIG_PLUGIN_ACTIVE: '' } }
      match: { out: { active: [] } } }
  ]


  profile: set: [
    { id: 'env/profile#set', doc: true
      in: { refs: [], env: { VOXGIG_PLUGIN_PROFILE: 'prod' } }
      match: { out: { profile: 'prod' } } }
  ]


  ambiguous: set: [
    { id: 'env/ambiguous#tag-vs-underscore', doc: true
      in: { refs: ['retry$fast', 'retry__fast'], env: {} }
      err: true, match: { err: { code: 'plugin_env_ambiguous' } } }
    { in: { refs: ['retry$fast', 'Retry$fast'], env: {} }, err: true, match: { err: { code: 'plugin_env_ambiguous' } } }
    { in: { refs: ['retry$fast', 'retry$Fast'], env: {} }, err: true, match: { err: { code: 'plugin_env_ambiguous' } } }
    { in: { refs: ['retry$fast', 'retry__fast'], env: {} }
      err: true, match: { err: { message: '/retry\\$fast/' } } }
    { in: { refs: ['retry$fast', 'retry__fast'], env: {} }
      err: true, match: { err: { message: '/retry__fast/' } } }
    { in: { refs: ['retry', 'retry$fast', 'other'], env: {} }
      match: { out: { options: {} } } }
  ]


  reserved: set: [
    { id: 'env/reserved#inactive', doc: true
      in: { refs: ['station'], reserved: ['station'], env: { VOXGIG_PLUGIN_INACTIVE: 'station' } }
      err: true, match: { err: { code: 'plugin_ref_reserved' } } }
    { in: { refs: ['station'], reserved: ['station'], env: { VOXGIG_PLUGIN_ACTIVE: 'station' } }
      err: true, match: { err: { code: 'plugin_ref_reserved' } } }
    { in: { refs: ['station$eu'], reserved: ['station'], env: { VOXGIG_PLUGIN_INACTIVE: 'station$eu' } }
      err: true, match: { err: { code: 'plugin_ref_reserved' } } }
    { in: { refs: ['station'], reserved: ['station'], env: { VOXGIG_PLUGIN_STATION_X: '1' } }
      err: true, match: { err: { code: 'plugin_ref_reserved' } } }
    { in: { refs: ['stationary'], reserved: ['station'], env: { VOXGIG_PLUGIN_INACTIVE: 'stationary' } }
      match: { out: { inactive: ['stationary'] } } }
  ]
}



primary: version: {

  range: set: [
    { id: 'version/range#component-max'
      in: '2147483647', out: { lo: [2147483647, 0, 0], hi: [2147483648, 0, 0] } }
    { id: 'version/range#caret', doc: true, in: '2.1', out: { lo: [2, 1, 0], hi: [3, 0, 0] } }
    { in: '2', out: { lo: [2, 0, 0], hi: [3, 0, 0] } }
    { in: '2.1.3', out: { lo: [2, 1, 3], hi: [3, 0, 0] } }
    { in: '~2.1', out: { lo: [2, 1, 0], hi: [2, 2, 0] } }
    { in: '~2', out: { lo: [2, 0, 0], hi: [2, 1, 0] } }
    { in: '~2.1.3', out: { lo: [2, 1, 3], hi: [2, 2, 0] } }
    { in: '0.1', out: { lo: [0, 1, 0], hi: [1, 0, 0] } }
  ]


  rangebad: set: [
    { id: 'version/rangebad#empty', doc: true, in: '', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: 'x', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: '2.x', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: '>=2.1', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: '^2.1', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: '2.1.3.4', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: '~', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: '-1', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { id: 'version/rangebad#trailing-newline', in: "2.1\n", err: true, match: { err: { code: 'plugin_bad_range' } } }
    { id: 'version/rangebad#component-bound', in: '9223372036854775808', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: '2147483648', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: '1.2147483648', err: true, match: { err: { code: 'plugin_bad_range' } } }
    { in: '1.2.2147483648', err: true, match: { err: { code: 'plugin_bad_range' } } }
  ]


  satisfies: set: [
    { id: 'version/satisfies#in', doc: true, in: { version: '2.3', range: '2.1' }, out: true }
    { in: { version: '2.1', range: '2.1' }, out: true }
    { in: { version: '2.1.0', range: '2.1' }, out: true }
    { in: { version: '2.99.99', range: '2.1' }, out: true }
    { in: { version: '3.0', range: '2.1' }, out: false }
    { in: { version: '2.0', range: '2.1' }, out: false }
    { in: { version: '2.0.9', range: '2.1' }, out: false }
    { in: { version: '1.9', range: '2.1' }, out: false }

    # The tilde form is tighter on the MINOR, which is the distinction
    # the whole two-form grammar exists to draw.
    { in: { version: '2.1.9', range: '~2.1' }, out: true }
    { in: { version: '2.2.0', range: '~2.1' }, out: false }
    { in: { version: '2.2', range: '2.1' }, out: true }

    { id: 'version/satisfies#lo-inclusive', in: { version: '2.1.0', range: '~2.1' }, out: true }
    { in: { version: '2.0.99', range: '~2.1' }, out: false }
    { in: { version: '3.0.0', range: '2.1' }, out: false }
  ]
}



primary: capability: {

  match: set: [
    {
      id: 'capability/match#name', doc: true
      in: { req: { name: 'clock' }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'clock' } } ] }
      match: { out: [ { ref: 'a' } ] }
    }
    { in: { req: { name: 'clock' }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store' } } ] }
      out: [] }

    {
      id: 'capability/match#attrs'
      in: { req: { name: 'store', match: { transactional: true } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', attrs: { transactional: true } } } ] }
      match: { out: [ { ref: 'a' } ] }
    }
    { in: { req: { name: 'store', match: { transactional: true } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', attrs: { durable: true } } } ] }
      out: [] }
    { in: { req: { name: 'store', match: { transactional: true } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', attrs: { transactional: false } } } ] }
      out: [] }
    { in: { req: { name: 'store', match: { transactional: true } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store' } } ] }
      out: [] }
    { in: { req: { name: 'store', match: { a: 1, b: 2 } }
            candidates: [ { ref: 'x', pos: 0, provides: { name: 'store', attrs: { a: 1, b: 3 } } } ] }
      out: [] }

    { in: { req: { name: 'store', match: { transactional: true } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', attrs: { transactional: 1 } } } ] }
      out: [] }
    { in: { req: { name: 'store', match: { n: 1 } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', attrs: { n: true } } } ] }
      out: [] }
    # ...and the false/zero half, which a port that special-cased only
    # `true` would still get wrong.
    { in: { req: { name: 'store', match: { transactional: false } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', attrs: { transactional: 0 } } } ] }
      out: [] }
    { in: { req: { name: 'store', match: { n: 1 } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', attrs: { n: '1' } } } ] }
      out: [] }
    { in: { req: { name: 'store', match: { n: '1' } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', attrs: { n: 1 } } } ] }
      out: [] }
    # The matching pairs still match, so the guard cannot have been
    # written as "compound values never match".
    { in: { req: { name: 'store', match: { transactional: true, n: 1 } }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', attrs: { transactional: true, n: 1 } } } ] }
      match: { out: [ { ref: 'a' } ] } }

    { in: { req: { name: 'store', range: '2.1' }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', version: '2.3' } } ] }
      match: { out: [ { ref: 'a' } ] } }
    { in: { req: { name: 'store', range: '2.1' }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store', version: '3.0' } } ] }
      out: [] }
    { in: { req: { name: 'store', range: '2.1' }
            candidates: [ { ref: 'a', pos: 0, provides: { name: 'store' } } ] }
      out: [] }
  ]


  nested: set: [
    {
      id: 'capability/nested#leaf', doc: true
      in: { req: { name: 'store', match: { limits: { max: 5 } } }
            candidates: [ { ref: 'a', pos: 0
                            provides: { name: 'store', attrs: { limits: { max: 5, min: 1 } } } } ] }
      match: { out: [ { ref: 'a' } ] }
    }
    # Keys not mentioned are not checked AT EVERY LEVEL — `min` above is
    # ignored, not a mismatch.
    { in: { req: { name: 'store', match: { limits: { max: 5 } } }
            candidates: [ { ref: 'a', pos: 0
                            provides: { name: 'store', attrs: { limits: { max: 9 } } } } ] }
      out: [] }
    # A key the provider never declared is a miss ONE LEVEL DOWN exactly
    # as it is at the top: asking for `limits.max` must not be satisfied
    # by a provider that never said what its limits are.
    { in: { req: { name: 'store', match: { limits: { max: 5 } } }
            candidates: [ { ref: 'a', pos: 0
                            provides: { name: 'store', attrs: { limits: {} } } } ] }
      out: [] }
    { in: { req: { name: 'store', match: { limits: { max: 5 } } }
            candidates: [ { ref: 'a', pos: 0
                            provides: { name: 'store', attrs: { limits: 5 } } } ] }
      out: [] }

    { in: { req: { name: 'store', match: { regions: ['eu', 'us'] } }
            candidates: [ { ref: 'a', pos: 0
                            provides: { name: 'store', attrs: { regions: ['eu', 'us'] } } } ] }
      match: { out: [ { ref: 'a' } ] } }
    { in: { req: { name: 'store', match: { regions: ['eu'] } }
            candidates: [ { ref: 'a', pos: 0
                            provides: { name: 'store', attrs: { regions: ['eu', 'us'] } } } ] }
      out: [] }
    { in: { req: { name: 'store', match: { regions: ['us', 'eu'] } }
            candidates: [ { ref: 'a', pos: 0
                            provides: { name: 'store', attrs: { regions: ['eu', 'us'] } } } ] }
      out: [] }
  ]


  # THE RANK, in order: highest `version`, then LOWEST `priority`
  # (default 0), then declaration position `pos` ascending.
  rank: set: [
    {
      id: 'capability/rank#version', doc: true
      in: { req: { name: 's' }, candidates: [
        { ref: 'lo', pos: 0, provides: { name: 's', version: '2.1' } }
        { ref: 'hi', pos: 1, provides: { name: 's', version: '2.9' } }
      ] }
      match: { out: [ { ref: 'hi' }, { ref: 'lo' } ] }
    }
    {
      id: 'capability/rank#priority'
      in: { req: { name: 's' }, candidates: [
        { ref: 'b', pos: 0, provides: { name: 's', version: '2.1', priority: 5 } }
        { ref: 'a', pos: 1, provides: { name: 's', version: '2.1', priority: 1 } }
      ] }
      match: { out: [ { ref: 'a' }, { ref: 'b' } ] }
    }
    {
      in: { req: { name: 's' }, candidates: [
        { ref: 'set', pos: 0, provides: { name: 's', version: '2.1', priority: 1 } }
        { ref: 'unset', pos: 1, provides: { name: 's', version: '2.1' } }
      ] }
      match: { out: [ { ref: 'unset' }, { ref: 'set' } ] }
    }
    {
      in: { req: { name: 's' }, candidates: [
        { ref: 'second', pos: 1, provides: { name: 's', version: '2.1' } }
        { ref: 'first', pos: 0, provides: { name: 's', version: '2.1' } }
      ] }
      match: { out: [ { ref: 'first' }, { ref: 'second' } ] }
    }
    # VERSION OUTRANKS PRIORITY. A port applying them in the other order
    # passes both single-axis cases above and fails this one.
    {
      id: 'capability/rank#version-beats-priority'
      in: { req: { name: 's' }, candidates: [
        { ref: 'newer', pos: 0, provides: { name: 's', version: '3.0', priority: 9 } }
        { ref: 'older', pos: 1, provides: { name: 's', version: '2.0', priority: 0 } }
      ] }
      match: { out: [ { ref: 'newer' }, { ref: 'older' } ] }
    }
    {
      in: { req: { name: 's' }, candidates: [
        { ref: 'late', pos: 9, provides: { name: 's', version: '2.0', priority: 0 } }
        { ref: 'early', pos: 0, provides: { name: 's', version: '2.0', priority: 5 } }
      ] }
      match: { out: [ { ref: 'late' }, { ref: 'early' } ] }
    }
  ]
}



primary: graph: {

  resolve: set: [
    {
      id: 'graph/resolve#trivial', doc: true
      in: [ { ref: 'a', pos: 0 }, { ref: 'b', pos: 1 } ]
      out: { resolved: ['a', 'b'], blocked: [] }
    }
    {
      in: [ { ref: 'p', pos: 0, provides: [ { name: 'clock' } ] }
            { ref: 'c', pos: 1, requires: [ { name: 'clock' } ] } ]
      out: { resolved: ['c', 'p'], blocked: [] }
    }
    {
      in: [ { ref: 'c', pos: 0, requires: [ { name: 'clock', optional: true } ] } ]
      out: { resolved: ['c'], blocked: [] }
    }
    {
      id: 'graph/resolve#chain'
      in: [ { ref: 'c', pos: 0, requires: [ { name: 'b' } ] }
            { ref: 'b', pos: 1, provides: [ { name: 'b' } ], requires: [ { name: 'a' } ] }
            { ref: 'a', pos: 2, provides: [ { name: 'a' } ] } ]
      out: { resolved: ['a', 'b', 'c'], blocked: [] }
    }
    {
      id: 'graph/resolve#byref'
      in: [ { ref: 'p', pos: 0 }
            { ref: 'c', pos: 1, requires: [ { name: 'p' } ] } ]
      out: { resolved: ['c', 'p'], blocked: [] }
    }
    {
      id: 'graph/resolve#byref-canonical'
      in: [ { ref: 'p', pos: 0 }
            { ref: 'c', pos: 1, requires: [ { name: 'p$' } ] } ]
      out: { resolved: ['c', 'p'], blocked: [] }
    }
    # A NAME NO REF COULD HAVE is a capability name and nothing else.
    # `2fa` is a perfectly good capability - the design puts no grammar
    # on capability names, only on plugin names (§4) - so the ref
    # comparison must ANSWER "not a ref" rather than raising.
    {
      id: 'graph/resolve#capability-not-a-ref'
      in: [ { ref: 'p', pos: 0, provides: [ { name: '2fa' } ] }
            { ref: 'c', pos: 1, requires: [ { name: '2fa' } ] } ]
      out: { resolved: ['c', 'p'], blocked: [] }
    }
  ]


  blocked: set: [
    {
      id: 'graph/blocked#absent', doc: true
      in: [ { ref: 'c', pos: 0, requires: [ { name: 'clock' } ] } ]
      out: { resolved: [], blocked: [ { ref: 'c', unmet: 'clock', why: { kind: 'absent' } } ] }
    }
    # A REF THAT IS NOT IN THE GRAPH is `absent` too - the ref path adds
    # a way to be satisfied, not a way to be excused.
    {
      id: 'graph/blocked#byref-absent'
      in: [ { ref: 'c', pos: 0, requires: [ { name: 'nope$1' } ] } ]
      out: { resolved: [], blocked: [ { ref: 'c', unmet: 'nope$1', why: { kind: 'absent' } } ] }
    }
    # A provider at an incompatible version — WITH BOTH the range asked
    # for and the version found, because "version mismatch" without the
    # numbers is the OSGi diagnostic this design exists to avoid.
    {
      id: 'graph/blocked#version'
      in: [ { ref: 'p', pos: 0, provides: [ { name: 's', version: '1.0' } ] }
            { ref: 'c', pos: 1, requires: [ { name: 's', range: '2.1' } ] } ]
      out: { resolved: ['p'], blocked: [
        { ref: 'c', unmet: 's', why: { kind: 'version', range: '2.1', found: ['1.0'] } } ] }
    }
    {
      id: 'graph/blocked#match'
      in: [ { ref: 'p', pos: 0, provides: [ { name: 's', attrs: { transactional: false } } ] }
            { ref: 'c', pos: 1, requires: [ { name: 's', match: { transactional: true } } ] } ]
      out: { resolved: ['p'], blocked: [
        { ref: 'c', unmet: 's'
          why: { kind: 'match', failing: 'transactional', want: true, found: false } } ] }
    }
    {
      in: [ { ref: 'p', pos: 0, provides: [ { name: 's' } ] }
            { ref: 'c', pos: 1, requires: [ { name: 's', match: { transactional: true } } ] } ]
      out: { resolved: ['p'], blocked: [
        { ref: 'c', unmet: 's'
          why: { kind: 'match', failing: 'transactional', want: true, found: null } } ] }
    }
    {
      id: 'graph/blocked#match-nested'
      in: [ { ref: 'p', pos: 0, provides: [ { name: 's', attrs: { limits: { max: 9 } } } ] }
            { ref: 'c', pos: 1, requires: [ { name: 's', match: { limits: { max: 5 } } } ] } ]
      out: { resolved: ['p'], blocked: [
        { ref: 'c', unmet: 's'
          why: { kind: 'match', failing: 'limits'
                 want: { max: 5 }, found: { max: 9 } } } ] }
    }
    # A provider that is ITSELF blocked, with the chain — so the reader
    # follows one hop rather than re-deriving the graph.
    {
      id: 'graph/blocked#chain'
      in: [ { ref: 'c', pos: 0, requires: [ { name: 'b' } ] }
            { ref: 'b', pos: 1, provides: [ { name: 'b' } ], requires: [ { name: 'missing' } ] } ]
      out: { resolved: [], blocked: [
        { ref: 'b', unmet: 'missing', why: { kind: 'absent' } }
        { ref: 'c', unmet: 'b', why: { kind: 'blocked', chain: ['b'] } } ] }
    }
    # ONE BLOCKED THING DOES NOT BLOCK THE INNOCENT. This is the whole
    # point of resolving the graph as a phase.
    {
      id: 'graph/blocked#isolated'
      in: [ { ref: 'c', pos: 0, requires: [ { name: 'missing' } ] }
            { ref: 'x', pos: 1 }
            { ref: 'y', pos: 2 } ]
      match: { out: { resolved: ['x', 'y'] } }
    }
  ]
}



primary: resolve: {

  candidates: set: [
    {
      id: 'resolve/candidates#default', doc: true
      in: { name: 'retry' }
      out: ['@voxgig/plugin-retry', 'voxgig-plugin-retry', 'plugin-retry', 'retry']
    }
    {
      in: { name: 'retry', sources: [ { kind: 'module', prefix: ['x-'] } ] }
      out: ['x-retry']
    }
    # ORDER IS THE ANSWER, not the set: the first id that loads wins, so
    # a port returning the same ids in a different order resolves a
    # different module.
    {
      in: { name: 'r', sources: [ { kind: 'module', prefix: ['a-', 'b-'] } ] }
      out: ['a-r', 'b-r']
    }
    { in: { name: 'r', sources: [ { kind: 'path', dir: './plugin' } ] }, out: ['./plugin/r'] }
    { in: { name: 'r', sources: [ { kind: 'path', dir: './plugin/' } ] }, out: ['./plugin/r'] }
    {
      in: { name: 'r', sources: [ { kind: 'path', dir: './p' }, { kind: 'module', prefix: ['m-'] } ] }
      out: ['./p/r', 'm-r']
    }
    # Duplicates collapse, keeping the FIRST occurrence — trying the
    # same id twice is not wrong, it is just noise in the answer.
    {
      in: { name: 'r', sources: [ { kind: 'module', prefix: ['a-', 'a-'] } ] }
      out: ['a-r']
    }
    {
      id: 'resolve/candidates#scoped-verbatim'
      in: { name: '@acme/thing' }
      out: ['@acme/thing']
    }
    {
      in: { name: '@acme/thing', sources: [ { kind: 'module', prefix: ['x-'] } ] }
      out: ['@acme/thing']
    }
    {
      in: { name: '@acme/thing', sources: [ { kind: 'path', dir: './p' } ] }
      out: ['@acme/thing']
    }
  ]


  from: set: [
    { id: 'resolve/from#verbatim', doc: true, in: './local/thing', out: ['./local/thing'] }
    { in: '/abs/path', out: ['/abs/path'] }
    { in: '../up/one', out: ['../up/one'] }
  ]
}



primary: point: {

  # `hook` — fan-out. Every live binding runs, in resolved order (§7),
  # and return values are ignored. The probe counts its calls, so the
  # observable shows how many bindings actually ran.
  hook: set: [
    {
      id: 'point/hook#fanout', doc: true
      in: [
        { do: 'host', points: { p: { kind: 'hook' } } }
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b' }
        { do: 'emit', point: 'p' }
        { do: 'call', ref: 'probe$a', method: 'count' }
      ]
      match: { out: { result: 1 } }
    }
    # A DEACTIVATED instance does not run. This is the whole point of
    # the inversion: removing a binding is removing a slot, not undoing
    # a mutation nobody recorded.
    {
      id: 'point/hook#deactivated'
      in: [
        { do: 'host', points: { p: { kind: 'hook' } } }
        { do: 'ready', ref: 'probe$a' }
        { do: 'deactivate', ref: 'probe$a' }
        { do: 'emit', point: 'p' }
        { do: 'call', ref: 'probe$a', method: 'count' }
      ]
      match: { out: { result: 0 } }
    }
    {
      in: [ { do: 'host', points: {} }, { do: 'emit', point: 'nope' } ]
      err: true, match: { err: { code: 'plugin_point_unknown' } }
    }
    # Emitting on a chain point is a KIND error — the two are not
    # interchangeable and a host that confuses them gets told.
    {
      in: [
        { do: 'host', points: { c: { kind: 'chain' } } }
        { do: 'emit', point: 'c' }
      ]
      err: true, match: { err: { code: 'plugin_point_kind' } }
    }
  ]


  # `bail` — stops at the first binding that RETURNS A VALUE. The
  # "handled, stop" case. A NULL DECLINES: a binding that has nothing to
  # say returns nothing, and the next one gets its turn.
  bail: set: [
    {
      id: 'point/bail#stops', doc: true
      in: [
        { do: 'host', points: { v: { kind: 'hook', mode: 'bail' } } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: 'A' } }
        { do: 'ready', ref: 'provider$b', definition: 'provider', options: { point: 'v', value: 'B' } }
        { do: 'emit', point: 'v' }
      ]
      match: { out: { result: 'A' } }
    }
    {
      in: [
        { do: 'host', points: { v: { kind: 'hook', mode: 'bail' } } }
        { do: 'emit', point: 'v' }
      ]
      match: { out: { result: '__NULL__' } }
    }
    {
      id: 'point/bail#null-declines', doc: true
      in: [
        { do: 'host', points: { v: { kind: 'hook', mode: 'bail' } } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: null } }
        { do: 'ready', ref: 'provider$b', definition: 'provider', options: { point: 'v', value: 'B' } }
        { do: 'emit', point: 'v' }
      ]
      match: { out: { result: 'B' } }
    }
    {
      in: [
        { do: 'host', points: { v: { kind: 'hook', mode: 'bail' } } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: false } }
        { do: 'ready', ref: 'provider$b', definition: 'provider', options: { point: 'v', value: 'B' } }
        { do: 'emit', point: 'v' }
      ]
      match: { out: { result: false } }
    }
  ]


  # `chain` — composition. b1(b2(b3(base))), FIRST BINDING OUTERMOST
  # (§6.2). The probe prepends its `wrap` string, so the result spells
  # out the nesting order rather than merely asserting it.
  chain: set: [
    {
      id: 'point/chain#outermost', doc: true
      in: [
        { do: 'host', points: { c: { kind: 'chain' } } }
        { do: 'ready', ref: 'probe$a', options: { wrap: 'A' } }
        { do: 'ready', ref: 'probe$b', options: { wrap: 'B' } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'ABx' } }
    }
    {
      id: 'point/chain#band'
      in: [
        { do: 'host', points: { c: { kind: 'chain' } } }
        { do: 'ready', ref: 'probe$a', options: { wrap: 'A' }, order: { band: 10 } }
        { do: 'ready', ref: 'probe$b', options: { wrap: 'B' }, order: { band: 1 } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'BAx' } }
    }
    {
      in: [
        { do: 'host', points: { c: { kind: 'chain' } } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'x' } }
    }
    # Deactivating a link RECOMPOSES — the composition is recomputed on
    # any change to the live set, not cached at startup (§6.2).
    {
      id: 'point/chain#recompose'
      in: [
        { do: 'host', points: { c: { kind: 'chain' } } }
        { do: 'ready', ref: 'probe$a', options: { wrap: 'A' } }
        { do: 'ready', ref: 'probe$b', options: { wrap: 'B' } }
        { do: 'deactivate', ref: 'probe$a' }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'Bx' } }
    }
  ]


  provider: set: [
    {
      id: 'point/provider#one', doc: true
      in: [
        { do: 'host', points: { v: { kind: 'provider' } } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: 'A' } }
        { do: 'provider', point: 'v' }
      ]
      match: { out: { result: 'A' } }
    }
    {
      id: 'point/provider#highest'
      in: [
        { do: 'host', points: { v: { kind: 'provider' } } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: 'A' }, order: { band: 1 } }
        { do: 'ready', ref: 'provider$b', definition: 'provider', options: { point: 'v', value: 'B' }, order: { band: 9 } }
        { do: 'provider', point: 'v' }
      ]
      match: { out: { result: 'B' } }
    }
    {
      id: 'point/provider#shadowed'
      in: [
        { do: 'host', points: { v: { kind: 'provider' } } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: 'A' }, order: { band: 1 } }
        { do: 'ready', ref: 'provider$b', definition: 'provider', options: { point: 'v', value: 'B' }, order: { band: 9 } }
        { do: 'shadowed', point: 'v' }
      ]
      match: { out: { result: ['provider$a'] } }
    }
    {
      id: 'point/provider#tie-by-ref'
      in: [
        { do: 'host', points: { v: { kind: 'provider' } } }
        { do: 'ready', ref: 'provider$b', definition: 'provider', options: { point: 'v', value: 'B' } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: 'A' } }
        { do: 'provider', point: 'v' }
      ]
      match: { out: { result: 'A' } }
    }
    {
      in: [
        { do: 'host', points: { v: { kind: 'provider' } } }
        { do: 'ready', ref: 'provider$b', definition: 'provider', options: { point: 'v', value: 'B' } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: 'A' } }
        { do: 'shadowed', point: 'v' }
      ]
      match: { out: { result: ['provider$b'] } }
    }
    {
      in: [
        { do: 'host', points: { v: { kind: 'provider', default: 'D' } } }
        { do: 'provider', point: 'v' }
      ]
      match: { out: { result: 'D' } }
    }
    # `exclusive: true` makes a SECOND binding an error instead of a
    # shadow — for a host that would rather fail than pick.
    {
      id: 'point/provider#exclusive'
      in: [
        { do: 'host', points: { v: { kind: 'provider', exclusive: true } } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: 'A' } }
        { do: 'ready', ref: 'provider$b', definition: 'provider', options: { point: 'v', value: 'B' } }
        { do: 'provider', point: 'v' }
      ]
      err: true, match: { err: { code: 'plugin_point_exclusive' } }
    }
    {
      in: [
        { do: 'host', points: { v: { kind: 'provider', exclusive: true } } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v', value: 'A' } }
        { do: 'provider', point: 'v' }
      ]
      match: { out: { result: 'A' } }
    }
  ]


  position: set: [
    {
      id: 'point/position#outermost', doc: true
      in: [
        { do: 'ready', ref: 'probe$a', options: { wrap: 'A' } }
        { do: 'ready', ref: 'probe$b', options: { wrap: 'B' } }
        { do: 'call', ref: 'probe$a', method: 'position', point: 'c' }
      ]
      match: { out: { result: { index: 0, count: 2, outermost: true, innermost: false } } }
    }
    {
      id: 'point/position#innermost'
      in: [
        { do: 'ready', ref: 'probe$a', options: { wrap: 'A' } }
        { do: 'ready', ref: 'probe$b', options: { wrap: 'B' } }
        { do: 'call', ref: 'probe$b', method: 'position', point: 'c' }
      ]
      match: { out: { result: { index: 1, count: 2, outermost: false, innermost: true } } }
    }
    {
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'position', point: 'c' }
      ]
      match: { out: { result: { index: 0, count: 1, outermost: true, innermost: true } } }
    }
    # And the composition AGREES with the flags — the same chain, read
    # both ways, so a port cannot satisfy one and invert the other.
    {
      id: 'point/position#agrees-with-composition'
      in: [
        { do: 'ready', ref: 'probe$a', options: { wrap: 'A' } }
        { do: 'ready', ref: 'probe$b', options: { wrap: 'B' } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'ABx' } }
    }
  ]


  # BINDINGS GO LIVE ONLY WHEN ACTIVATION SUCCEEDS (§8.1). A `loaded`
  # instance has DECLARED its bindings and the host has not inserted
  # them, which is what makes `deactivate` a pure removal and `activate`
  # a pure insertion, with no discovery in between.
  insert: set: [
    {
      id: 'point/insert#loaded-not-bound', doc: true
      in: [
        { do: 'host', points: { p: { kind: 'hook' } } }
        { do: 'load', ref: 'probe$a' }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: [] } }
    }
    {
      in: [
        { do: 'host', points: { p: { kind: 'hook' } } }
        { do: 'ready', ref: 'probe$a' }
        { do: 'order', point: 'p' }
      ]
      match: { out: { result: ['probe$a'] } }
    }
  ]
}



primary: export: {

  key: set: [
    {
      id: 'export/key#qualified', doc: true
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'export', key: 'probe$a/client' }
      ]
      match: { out: { result: 'probe$a' } }
    }
    {
      in: [ { do: 'ready', ref: 'probe$a' }, { do: 'export', key: 'probe$a/nope' } ]
      match: { out: { result: '__NULL__' } }
    }
    # EXPORTS OF A `loaded` (not live) INSTANCE ARE VISIBLE (§11). They
    # are declared in `define`, they are data, and hiding them would
    # make the loaded state useless for introspection.
    {
      id: 'export/key#loaded-visible'
      in: [ { do: 'load', ref: 'probe$a' }, { do: 'export', key: 'probe$a/client' } ]
      match: { out: { result: 'probe$a' } }
    }

    {
      id: 'export/key#second-key', doc: true
      in: [ { do: 'ready', ref: 'probe$a' }, { do: 'export', key: 'probe$a/mark' } ]
      match: { out: { result: 'marked' } }
    }
    # BOTH ORDERS, because one of them is what a first-export-wins port
    # would pass: reading `client` then `mark` must answer `marked`...
    {
      id: 'export/key#two-keys'
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'export', key: 'probe$a/client' }
        { do: 'export', key: 'probe$a/mark' }
      ]
      match: { out: { result: 'marked' } }
    }
    # ...and reading `mark` then `client` must answer the ref. A port
    # answering from position rather than from the key fails one of these
    # whichever position it picks.
    {
      id: 'export/key#two-keys-reversed'
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'export', key: 'probe$a/mark' }
        { do: 'export', key: 'probe$a/client' }
      ]
      match: { out: { result: 'probe$a' } }
    }

    {
      id: 'export/key#scoped', doc: true
      in: [
        { do: 'define', name: '@acme/probe', probe: 'probe' }
        { do: 'ready', ref: '@acme/probe$a' }
        { do: 'export', key: '@acme/probe$a/client' }
      ]
      match: { out: { result: '@acme/probe$a' } }
    }
    {
      id: 'export/key#scoped-untagged'
      in: [
        { do: 'define', name: '@acme/probe', probe: 'probe' }
        { do: 'ready', ref: '@acme/probe' }
        { do: 'export', key: '@acme/probe/client' }
      ]
      match: { out: { result: '@acme/probe' } }
    }
    # The ALIAS half splits the same way, or a scoped name would resolve
    # qualified and not unqualified.
    {
      id: 'export/key#scoped-alias'
      in: [
        { do: 'define', name: '@acme/probe', probe: 'probe' }
        { do: 'ready', ref: '@acme/probe$a' }
        { do: 'export', key: '@acme/probe/client' }
      ]
      match: { out: { result: '@acme/probe$a' } }
    }
    # A key nothing exports is still absent, scoped or not — the split
    # moved, the answer for a miss did not.
    {
      in: [
        { do: 'define', name: '@acme/probe', probe: 'probe' }
        { do: 'ready', ref: '@acme/probe$a' }
        { do: 'export', key: '@acme/probe$a/nope' }
      ]
      match: { out: { result: '__NULL__' } }
    }
  ]


  alias: set: [
    {
      id: 'export/alias#untagged-wins', doc: true
      in: [
        { do: 'ready', ref: 'probe' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'export', key: 'probe/client' }
      ]
      match: { out: { result: 'probe' } }
    }
    {
      in: [ { do: 'ready', ref: 'probe$a' }, { do: 'export', key: 'probe/client' } ]
      match: { out: { result: 'probe$a' } }
    }
    # ...and the alias keys the same way the qualified form does, which
    # is a second branch and so a second place to get it wrong.
    {
      id: 'export/alias#second-key'
      in: [ { do: 'ready', ref: 'probe$a' }, { do: 'export', key: 'probe/mark' } ]
      match: { out: { result: 'marked' } }
    }
    {
      id: 'export/alias#ambiguous'
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b' }
        { do: 'export', key: 'probe/client' }
      ]
      err: true, match: { err: { code: 'plugin_export_ambiguous' } }
    }
    # The message names every candidate — one name leaves the reader
    # guessing which pair collided.
    {
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b' }
        { do: 'export', key: 'probe/client' }
      ]
      err: true, match: { err: { message: '/probe\\$a/' } }
    }
  ]
}



primary: depend: {

  pending: set: [
    {
      id: 'depend/pending#unmet', doc: true
      in: [
        { do: 'load', ref: 'dep$a', options: { requires: ['clock'] } }
        { do: 'activate', ref: 'dep$a' }
      ]
      match: { out: { status: { 'dep$a': 'pending' } } }
    }
    {
      id: 'depend/pending#capability'
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'load', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'activate', ref: 'dep$c' }
      ]
      match: { out: { status: { 'dep$c': 'live' } } }
    }
    {
      in: [
        { do: 'load', ref: 'dep$a', options: { requires: ['clock'], optional: ['clock'] } }
        { do: 'activate', ref: 'dep$a' }
      ]
      match: { out: { status: { 'dep$a': 'live' } } }
    }
  ]


  bound: set: [
    {
      id: 'depend/bound#selected', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['clock'], capof: 'clock' } }
        { do: 'export', key: 'dep$c/cap' }
      ]
      match: { out: { result: 'dep$p' } }
    }
    {
      id: 'depend/bound#ranked'
      in: [
        { do: 'ready', ref: 'dep$lo', definition: 'dep'
          options: { provides: [ { name: 'clock', version: '1.0.0' } ] } }
        { do: 'ready', ref: 'dep$hi', definition: 'dep'
          options: { provides: [ { name: 'clock', version: '2.0.0' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['clock'], capof: 'clock' } }
        { do: 'export', key: 'dep$c/cap' }
      ]
      match: { out: { result: 'dep$hi' } }
    }
    {
      id: 'depend/bound#optional-absent'
      in: [
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['metrics'], optional: ['metrics'], capof: 'metrics' } }
        { do: 'export', key: 'dep$c/cap' }
      ]
      match: { out: { result: '__NULL__' } }
    }
    # A NAME THIS INSTANCE DOES NOT REQUIRE is absent too, rather than
    # answering with whoever happens to provide it: the question is what
    # THIS instance is bound to.
    {
      id: 'depend/bound#not-required'
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['other'], optional: ['other'], capof: 'clock' } }
        { do: 'export', key: 'dep$c/cap' }
      ]
      match: { out: { result: '__NULL__' } }
    }
    {
      id: 'depend/bound#named-second'
      in: [
        { do: 'ready', ref: 'dep$o', definition: 'dep', options: { provides: [ { name: 'other' } ] } }
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['other', 'clock'], capof: 'clock' } }
        { do: 'export', key: 'dep$c/cap' }
      ]
      match: { out: { result: 'dep$p' } }
    }
    {
      id: 'depend/bound#named-first'
      in: [
        { do: 'ready', ref: 'dep$o', definition: 'dep', options: { provides: [ { name: 'other' } ] } }
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['clock', 'other'], capof: 'clock' } }
        { do: 'export', key: 'dep$c/cap' }
      ]
      match: { out: { result: 'dep$p' } }
    }
    {
      id: 'depend/bound#by-ref', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep' }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['dep$p'], capof: 'dep$p' } }
        { do: 'export', key: 'dep$c/cap' }
      ]
      match: { out: { result: 'dep$p' } }
    }
    {
      id: 'depend/bound#by-ref-host-disagrees'
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep' }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['dep$p'], capof: 'dep$p' } }
        { do: 'capability', name: 'dep$p' }
      ]
      match: { out: { result: [] } }
    }
    {
      id: 'depend/bound#reluctant', doc: true
      in: [
        { do: 'ready', ref: 'dep$lo', definition: 'dep'
          options: { provides: [ { name: 'clock', version: '1.0.0' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['clock'], capof: 'clock' } }
        { do: 'ready', ref: 'dep$hi', definition: 'dep'
          options: { provides: [ { name: 'clock', version: '2.0.0' } ] } }
        { do: 'export', key: 'dep$c/cap' }
      ]
      match: { out: { result: 'dep$lo' } }
    }
    {
      id: 'depend/bound#dep-holds'
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['clock'], capof: 'clock' } }
        { do: 'export', key: 'dep$c/cap' }
      ]
      match: { out: { result: 'dep$p', open: 2 } }
    }
    {
      id: 'depend/bound#reluctant-host-ranks'
      in: [
        { do: 'ready', ref: 'dep$lo', definition: 'dep'
          options: { provides: [ { name: 'clock', version: '1.0.0' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['clock'], capof: 'clock' } }
        { do: 'ready', ref: 'dep$hi', definition: 'dep'
          options: { provides: [ { name: 'clock', version: '2.0.0' } ] } }
        { do: 'capability', name: 'clock' }
      ]
      match: { out: { result: ['dep$hi', 'dep$lo'] } }
    }
  ]


  byref: set: [
    {
      id: 'depend/byref#satisfies', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep' }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['dep$p'] } }
      ]
      match: { out: { status: { 'dep$p': 'live', 'dep$c': 'live' } } }
    }
    {
      id: 'depend/byref#canonical-comparison'
      in: [
        { do: 'ready', ref: 'dep', definition: 'dep' }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['dep$'] } }
      ]
      match: { out: { status: { 'dep': 'live', 'dep$c': 'live' } } }
    }
    {
      in: [
        { do: 'declare', ref: 'dep$p', definition: 'dep' }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['dep$p'] } }
      ]
      match: { out: { status: { 'dep$p': 'declared', 'dep$c': 'pending' } } }
    }
    # ...and `loaded` is not enough either, which is the line that makes
    # this the same rule as the capability one rather than a second one.
    {
      in: [
        { do: 'load', ref: 'dep$p', definition: 'dep' }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['dep$p'] } }
      ]
      match: { out: { status: { 'dep$p': 'loaded', 'dep$c': 'pending' } } }
    }
    {
      id: 'depend/byref#lost'
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep' }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['dep$p'] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$p': 'loaded', 'dep$c': 'pending' } } }
    }
    {
      id: 'depend/byref#lost-dynamic'
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep' }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['dep$p'], policy: 'dynamic' } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$p': 'loaded', 'dep$c': 'live' } } }
    }
    {
      id: 'depend/byref#lost-optional'
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep' }
        { do: 'ready', ref: 'dep$c', definition: 'dep'
          options: { requires: ['dep$p'], optional: ['dep$p'] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$p': 'loaded', 'dep$c': 'live' } } }
    }
    {
      id: 'depend/byref#capability-not-a-ref', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep'
          options: { provides: [ { name: '2fa' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['2fa'] } }
      ]
      match: { out: { status: { 'dep$p': 'live', 'dep$c': 'live' } } }
    }
    {
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep'
          options: { provides: [ { name: 'my cap' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['my cap'] } }
      ]
      match: { out: { status: { 'dep$p': 'live', 'dep$c': 'live' } } }
    }
    {
      in: [
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['2fa'] } }
      ]
      match: { out: { status: { 'dep$c': 'pending' } } }
    }
  ]


  arrive: set: [
    {
      id: 'depend/arrive#auto', doc: true
      in: [
        { do: 'load', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'activate', ref: 'dep$c' }
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
      ]
      match: { out: { status: { 'dep$c': 'live', 'dep$p': 'live' } } }
    }
    {
      id: 'depend/arrive#chain'
      in: [
        { do: 'load', ref: 'dep$c', definition: 'dep', options: { requires: ['b'] } }
        { do: 'activate', ref: 'dep$c' }
        { do: 'load', ref: 'dep$b', definition: 'dep', options: { requires: ['a'], provides: [ { name: 'b' } ] } }
        { do: 'activate', ref: 'dep$b' }
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'a' } ] } }
      ]
      match: { out: { status: { 'dep$a': 'live', 'dep$b': 'live', 'dep$c': 'live' } } }
    }
  ]


  lost: set: [
    {
      id: 'depend/lost#back-to-pending', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$c': 'pending', 'dep$p': 'loaded' } } }
    }
    {
      id: 'depend/lost#recursive'
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'a' } ] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { requires: ['a'], provides: [ { name: 'b' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['b'] } }
        { do: 'deactivate', ref: 'dep$a' }
      ]
      match: { out: { status: { 'dep$b': 'pending', 'dep$c': 'pending' } } }
    }
    # AND IT RECOVERS. The standing request was never withdrawn, so the
    # provider returning brings the whole chain back without anyone
    # asking again.
    {
      id: 'depend/lost#recovers'
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'a' } ] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { requires: ['a'], provides: [ { name: 'b' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['b'] } }
        { do: 'deactivate', ref: 'dep$a' }
        { do: 'activate', ref: 'dep$a' }
      ]
      match: { out: { status: { 'dep$a': 'live', 'dep$b': 'live', 'dep$c': 'live' } } }
    }
    # A `dynamic` consumer SAID IN WRITING that it can survive the
    # provider going away, so it stays live (§11.3). Static is the
    # default because most plugins cannot, and the cost of wrongly
    # assuming they can is a live instance holding a dead reference.
    {
      id: 'depend/lost#dynamic-stays'
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'], policy: 'dynamic' } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$c': 'live' } } }
    }
    {
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'], optional: ['clock'] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$c': 'live' } } }
    }
  ]


  # `host.capability(name)` returns the live providers, best first — the
  # same rank the `capability` section pins as pure data, now observed
  # through a host so the two cannot drift.
  select: set: [
    {
      id: 'depend/select#rank', doc: true
      in: [
        { do: 'ready', ref: 'dep$lo', definition: 'dep', options: { provides: [ { name: 's', version: '2.1' } ] } }
        { do: 'ready', ref: 'dep$hi', definition: 'dep', options: { provides: [ { name: 's', version: '2.9' } ] } }
        { do: 'capability', name: 's' }
      ]
      match: { out: { result: ['dep$hi', 'dep$lo'] } }
    }
    {
      in: [
        { do: 'ready', ref: 'dep$p1', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$p2', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'deactivate', ref: 'dep$p1' }
      ]
      match: { out: { status: { 'dep$c': 'live' } } }
    }
    {
      id: 'depend/select#reluctant', doc: true
      in: [
        { do: 'ready', ref: 'dep$lo', definition: 'dep', options: { provides: [ { name: 's', version: '2.1' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: [ { name: 's', range: '2.1' } ] } }
        { do: 'ready', ref: 'dep$hi', definition: 'dep', options: { provides: [ { name: 's', version: '2.9' } ] } }
        { do: 'deactivate', ref: 'dep$lo' }
      ]
      match: { out: { log: [
        'dep$lo:define', 'dep$lo:activate',
        'dep$c:define', 'dep$c:activate',
        'dep$hi:define', 'dep$hi:activate',
        'dep$c:deactivate', 'dep$lo:deactivate', 'dep$c:activate'
      ] } }
    }
    # ...and under `hold` the same fact is an error rather than a
    # cascade: the HOLDER of `dep$lo` is `dep$c`, because that is the
    # provider `dep$c` actually selected. A re-ranking host names
    # `dep$hi` instead and lets `dep$lo` go.
    {
      id: 'depend/select#reluctant-holds', doc: true
      in: [
        { do: 'host', dependency: 'hold' }
        { do: 'ready', ref: 'dep$lo', definition: 'dep', options: { provides: [ { name: 's', version: '2.1' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: [ { name: 's', range: '2.1' } ] } }
        { do: 'ready', ref: 'dep$hi', definition: 'dep', options: { provides: [ { name: 's', version: '2.9' } ] } }
        { do: 'deactivate', ref: 'dep$hi' }
      ]
      match: { out: { status: { 'dep$hi': 'loaded', 'dep$c': 'live', 'dep$lo': 'live' } } }
    }
    # ...and a selection belongs to ONE activation. After the consumer
    # goes down and comes back, it ranks afresh and takes `dep$hi`, so
    # `dep$hi` is now the one that cannot be deactivated under `hold`.
    {
      in: [
        { do: 'host', dependency: 'hold' }
        { do: 'ready', ref: 'dep$lo', definition: 'dep', options: { provides: [ { name: 's', version: '2.1' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: [ { name: 's', range: '2.1' } ] } }
        { do: 'ready', ref: 'dep$hi', definition: 'dep', options: { provides: [ { name: 's', version: '2.9' } ] } }
        { do: 'deactivate', ref: 'dep$c' }
        { do: 'activate', ref: 'dep$c' }
        { do: 'deactivate', ref: 'dep$hi' }
      ]
      err: true, match: { err: { code: 'plugin_dependency_held' } }
    }
  ]

  cascadefail: set: [
    {
      id: 'depend/cascadefail#consumer', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 's' } ] } }
        { do: 'ready', ref: 'noisy$c', options: { requires: ['s'], fail: 'deactivate' } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$p': 'loaded', 'noisy$c': 'failed' } } }
    }
    # ...and it is NOT revived when the provider comes back, which is the
    # whole reason `failed` is not `pending`.
    {
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 's' } ] } }
        { do: 'ready', ref: 'noisy$c', options: { requires: ['s'], fail: 'deactivate' } }
        { do: 'deactivate', ref: 'dep$p' }
        { do: 'activate', ref: 'dep$p' }
        { do: 'list' }
      ]
      match: { out: { result: { 'dep$p': 'live', 'noisy$c': 'failed' } } }
    }
  ]

  cascade: set: [
    {
      id: 'depend/cascade#consumer-first', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { log: [
        'dep$p:define', 'dep$p:activate', 'dep$c:define', 'dep$c:activate'
        'dep$c:deactivate', 'dep$p:deactivate'
      ] } }
    }
    # DEEPEST-FIRST through a chain: c depends on b depends on a, so
    # tearing down a runs c, then b, then a.
    {
      id: 'depend/cascade#deepest-first', doc: true
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'x' } ] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { provides: [ { name: 'y' } ], requires: ['x'] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['y'] } }
        { do: 'deactivate', ref: 'dep$a' }
      ]
      match: { out: { log: [
        'dep$a:define', 'dep$a:activate', 'dep$b:define', 'dep$b:activate'
        'dep$c:define', 'dep$c:activate'
        'dep$c:deactivate', 'dep$b:deactivate', 'dep$a:deactivate'
      ] } }
    }
    # `close` INHERITS THE ORDER, which is what makes apply's
    # reverse-load-order teardown safe even when a document happens to
    # list a consumer before its provider. Here the provider sorts first,
    # so a naive reverse-sorted close would tear it down before its
    # consumer.
    {
      id: 'depend/cascade#close-inherits', doc: true
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$z', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'close' }
      ]
      match: { out: { log: [
        'dep$a:define', 'dep$a:activate', 'dep$z:define', 'dep$z:activate'
        'dep$z:deactivate', 'dep$z:close', 'dep$a:deactivate', 'dep$a:close'
      ] } }
    }
  ]

  policy: set: [
    {
      id: 'depend/policy#per-requirement-dynamic', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: [ { name: 'clock', policy: 'dynamic' } ] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$c': 'live' } } }
    }
    {
      id: 'depend/policy#mixed-keeps-live-on-dynamic-loss', doc: true
      in: [
        { do: 'ready', ref: 'dep$s', definition: 'dep', options: { provides: [ { name: 'store' } ] } }
        { do: 'ready', ref: 'dep$m', definition: 'dep', options: { provides: [ { name: 'metrics' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: [
          { name: 'store' }
          { name: 'metrics', policy: 'dynamic' }
        ] } }
        { do: 'deactivate', ref: 'dep$m' }
      ]
      match: { out: { status: { 'dep$c': 'live' } } }
    }
    {
      id: 'depend/policy#mixed-restarts-on-static-loss', doc: true
      in: [
        { do: 'ready', ref: 'dep$s', definition: 'dep', options: { provides: [ { name: 'store' } ] } }
        { do: 'ready', ref: 'dep$m', definition: 'dep', options: { provides: [ { name: 'metrics' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: [
          { name: 'store' }
          { name: 'metrics', policy: 'dynamic' }
        ] } }
        { do: 'deactivate', ref: 'dep$s' }
      ]
      match: { out: { status: { 'dep$c': 'pending' } } }
    }
    {
      id: 'depend/policy#dynamic-still-gates-first-activation', doc: true
      in: [
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: [ { name: 'clock', policy: 'dynamic' } ] } }
      ]
      match: { out: { status: { 'dep$c': 'pending' } } }
    }
    {
      id: 'depend/policy#optional-static-restarts', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: [ { name: 'clock', optional: true } ] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: {
        status: { 'dep$c': 'live' }
        log: [
          'dep$p:define', 'dep$p:activate', 'dep$c:define', 'dep$c:activate'
          'dep$c:deactivate', 'dep$p:deactivate', 'dep$c:activate'
        ]
      } }
    }
    # ...and the fourth cell: OPTIONAL DYNAMIC is a notification and
    # nothing else, so no callback runs on the consumer at all.
    {
      id: 'depend/policy#optional-dynamic-is-untouched', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: [ { name: 'clock', optional: true, policy: 'dynamic' } ] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { log: [
        'dep$p:define', 'dep$p:activate', 'dep$c:define', 'dep$c:activate'
        'dep$p:deactivate'
      ] } }
    }
  ]

  cycle: set: [
    {
      id: 'depend/cycle#mutual-mandatory', doc: true
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'x' } ], requires: ['y'] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { provides: [ { name: 'y' } ], requires: ['x'] } }
      ]
      err: true, match: { err: { code: 'plugin_dependency_cycle' } }
    }
    {
      id: 'depend/cycle#three-node'
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'x' } ], requires: ['z'] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { provides: [ { name: 'y' } ], requires: ['x'] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { provides: [ { name: 'z' } ], requires: ['y'] } }
      ]
      err: true, match: { err: { code: 'plugin_dependency_cycle' } }
    }
    # A CYCLE THROUGH REFS IS A CYCLE (§11.1) - the edge does not have to
    # run through a declared capability, because a ref satisfies too and
    # an edge is "could this be the provider selected".
    {
      id: 'depend/cycle#through-refs'
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { requires: ['dep$b'] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { requires: ['dep$a'] } }
      ]
      err: true, match: { err: { code: 'plugin_dependency_cycle' } }
    }
    {
      id: 'depend/cycle#through-refs-noncanonical', doc: true
      in: [
        { do: 'ready', ref: 'dep', definition: 'dep', options: { requires: ['other$'] } }
        { do: 'ready', ref: 'other', definition: 'other', options: { requires: ['dep$'] } }
      ]
      err: true, match: { err: { code: 'plugin_dependency_cycle' } }
    }
    {
      id: 'depend/cycle#static-optional-still-cycles', doc: true
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'x' } ], requires: [ { name: 'y', optional: true } ] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { provides: [ { name: 'y' } ], requires: [ { name: 'x', optional: true } ] } }
      ]
      err: true, match: { err: { code: 'plugin_dependency_cycle' } }
    }
    {
      id: 'depend/cycle#dynamic-optional-is-permitted', doc: true
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'x' } ], requires: [ { name: 'y', optional: true, policy: 'dynamic' } ] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { provides: [ { name: 'y' } ], requires: [ { name: 'x', optional: true, policy: 'dynamic' } ] } }
      ]
      match: { out: { status: { 'dep$a': 'live', 'dep$b': 'live' } } }
    }
    # A MANDATORY DYNAMIC edge still cycles: it gates activation, so a
    # mutual pair still deadlocks even though neither would restart.
    {
      id: 'depend/cycle#mandatory-dynamic-still-cycles'
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'x' } ], requires: [ { name: 'y', policy: 'dynamic' } ] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { provides: [ { name: 'y' } ], requires: [ { name: 'x', policy: 'dynamic' } ] } }
      ]
      err: true, match: { err: { code: 'plugin_dependency_cycle' } }
    }
    {
      id: 'depend/cycle#chain-is-not-a-cycle', doc: true
      in: [
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'x' } ] } }
        { do: 'ready', ref: 'dep$b', definition: 'dep', options: { provides: [ { name: 'y' } ], requires: ['x'] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['y'] } }
      ]
      match: { out: { status: { 'dep$a': 'live', 'dep$b': 'live', 'dep$c': 'live' } } }
    }
  ]

  # `makeHost({dependency: 'hold'})` restores the strict reading (§11.3).
  # NOT the default, because a station that cannot swap a provider
  # without a restart has lost the argument for having a plugin system.
  hold: set: [
    {
      id: 'depend/hold#ad-hoc-deactivate-is-refused', doc: true
      in: [
        { do: 'host', dependency: 'hold' }
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      err: true, match: { err: { code: 'plugin_dependency_held' } }
    }
    {
      id: 'depend/hold#names-the-holders', doc: true
      in: [
        { do: 'host', dependency: 'hold' }
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      err: true
      match: { err: { message: '/holders=\\["dep\\$c"\\]/' } }
    }
    {
      id: 'depend/hold#mandatory-dynamic-holds', doc: true
      in: [
        { do: 'host', dependency: 'hold' }
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'], policy: 'dynamic' } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      err: true, match: { err: { code: 'plugin_dependency_held' } }
    }
    {
      id: 'depend/hold#optional-does-not-hold', doc: true
      in: [
        { do: 'host', dependency: 'hold' }
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'], optional: ['clock'] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$p': 'loaded', 'dep$c': 'live' } } }
    }
    {
      id: 'depend/hold#unheld-deactivates-normally'
      in: [
        { do: 'host', dependency: 'hold' }
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$p': 'loaded' } } }
    }
    {
      id: 'depend/hold#close-is-coordinated', doc: true
      in: [
        { do: 'host', dependency: 'hold' }
        { do: 'ready', ref: 'dep$a', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$z', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'close' }
      ]
      match: { out: { log: [
        'dep$a:define', 'dep$a:activate', 'dep$z:define', 'dep$z:activate'
        'dep$z:deactivate', 'dep$z:close', 'dep$a:deactivate', 'dep$a:close'
      ] } }
    }
    {
      id: 'depend/hold#restart-is-the-default', doc: true
      in: [
        { do: 'ready', ref: 'dep$p', definition: 'dep', options: { provides: [ { name: 'clock' } ] } }
        { do: 'ready', ref: 'dep$c', definition: 'dep', options: { requires: ['clock'] } }
        { do: 'deactivate', ref: 'dep$p' }
      ]
      match: { out: { status: { 'dep$p': 'loaded', 'dep$c': 'pending' } } }
    }
  ]
}



primary: declare: {

  clear: set: [
    {
      id: 'declare/clear#empty-options', doc: true
      in: [
        { do: 'declare', ref: 'probe$a', options: { wrap: 'A' } }
        { do: 'load', ref: 'probe$a', options: {} }
        { do: 'activate', ref: 'probe$a' }
        { arg: 'x', do: 'chain', point: 'c' }
      ]
      match: { out: { result: ':x' } }
    }
    # ...while OMITTING options leaves the declared ones alone, which is
    # the distinction truthiness cannot draw.
    {
      in: [
        { do: 'declare', ref: 'probe$a', options: { wrap: 'A' } }
        { do: 'load', ref: 'probe$a' }
        { do: 'activate', ref: 'probe$a' }
        { arg: 'x', do: 'chain', point: 'c' }
      ]
      match: { out: { result: 'Ax' } }
    }
  ]


  lookup: set: [
    {
      id: 'declare/lookup#malformed', doc: true
      in: [ { do: 'seq', ref: 'bad name' } ]
      err: true, match: { err: { code: 'plugin_bad_name' } }
    }
    # A WELL-FORMED ref that is simply absent is not an error - it is the
    # ordinary "nothing here" answer, and the pair is what keeps the two
    # distinguishable.
    {
      in: [ { do: 'seq', ref: 'probe$nope' } ]
      match: { out: { result: '__NULL__' } }
    }
  ]


  free: set: [
    {
      id: 'declare/free#nothing-runs', doc: true
      in: [
        { do: 'apply', doc: { plugin: 1, instance: {
          'probe$a': { start: 'lazy' }, 'probe$b': { start: 'lazy' } } } }
      ]
      out: { status: { 'probe$a': 'declared', 'probe$b': 'declared' }
             open: 0, log: [], result: null }
    }
    {
      in: [ { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } } ]
      match: { out: { status: { 'probe$a': 'live' } } }
    }
    # `active: false` BARS it: declared, and `ready` on it fails rather
    # than quietly doing nothing.
    {
      id: 'declare/free#barred'
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { active: false } } } }
      ]
      match: { out: { status: { 'probe$a': 'declared' }, log: [] } }
    }
    {
      id: 'declare/free#barred-stays-barred', doc: true
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { active: false } } } }
        { do: 'ready', ref: 'probe$a' }
      ]
      err: true, match: { err: { code: 'plugin_inactive' } }
    }
    { in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { active: false } } } }
        { do: 'activate', ref: 'probe$a' }
      ], err: true, match: { err: { code: 'plugin_inactive' } } }
    # ...and a document that turns it back on clears the bar. A bar that
    # could not be lifted would be a worse bug than one that never held.
    {
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { active: false } } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
      ]
      match: { out: { status: { 'probe$a': 'live' } } }
    }
  ]


  # AUTO-TAGGING IS EXPLICIT (§4 rule 3): `tag: '?'` assigns the LOWEST
  # UNUSED POSITIVE INTEGER and returns the assigned pair.
  autotag: set: [
    {
      id: 'declare/autotag#first', doc: true
      in: [ { do: 'declare', ref: 'probe', tag: '?' } ]
      match: { out: { result: 'probe$1' } }
    }
    { in: [ { do: 'declare', ref: 'probe', tag: '?' }, { do: 'declare', ref: 'probe', tag: '?' } ]
      match: { out: { result: 'probe$2' } } }
    {
      id: 'declare/autotag#fills-gap'
      in: [
        { do: 'declare', ref: 'probe$1' }
        { do: 'declare', ref: 'probe$3' }
        { do: 'declare', ref: 'probe', tag: '?' }
      ]
      match: { out: { result: 'probe$2' } }
    }
    {
      in: [ { do: 'declare', ref: 'probe$1' }, { do: 'declare', ref: 'probe', tag: '?' } ]
      match: { out: { result: 'probe$2' } }
    }
  ]


  seq: set: [
    {
      id: 'declare/seq#advances', doc: true
      in: [ { do: 'declare', ref: 'probe$a' }, { do: 'declare', ref: 'probe$b' }, { do: 'seq', ref: 'probe$b' } ]
      match: { out: { result: 1 } }
    }
    { in: [ { do: 'declare', ref: 'probe$a' }, { do: 'seq', ref: 'probe$a' } ]
      match: { out: { result: 0 } } }
    {
      id: 'declare/seq#fresh-on-reload'
      in: [
        { do: 'declare', ref: 'probe$a' }
        { do: 'declare', ref: 'probe$b' }
        { do: 'unload', ref: 'probe$a' }
        { do: 'declare', ref: 'probe$a' }
        { do: 'seq', ref: 'probe$a' }
      ]
      match: { out: { result: 2 } }
    }
    {
      id: 'declare/seq#pos-stable'
      in: [
        { do: 'apply', doc: { plugin: 1, instance: [ { ref: 'probe$a' }, { ref: 'probe$b' } ] } }
        { do: 'apply', doc: { plugin: 1, instance: [ { ref: 'probe$a', active: false }, { ref: 'probe$b' } ] } }
        { do: 'apply', doc: { plugin: 1, instance: [ { ref: 'probe$a' }, { ref: 'probe$b' } ] } }
        { do: 'pos', ref: 'probe$a' }
      ]
      match: { out: { result: 0 } }
    }
  ]


  register: set: [
    {
      id: 'declare/register#probe-differs-from-name', doc: true
      in: [
        { do: 'define', name: 'adapter', probe: 'noisy' }
        { do: 'load', ref: 'adapter$a', options: { fail: 'define', code: 'probe_boom' } }
      ]
      err: true, match: { err: { code: 'probe_boom' } }
    }
    # The pre-seeded `adapter` is a bare record probe that binds nothing,
    # so a driver that took the name and ignored `probe` answers 'x'.
    {
      id: 'declare/register#backed-by-probe'
      in: [
        { do: 'define', name: 'adapter', probe: 'probe' }
        { do: 'ready', ref: 'adapter$a' }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: ':x', status: { 'adapter$a': 'live' } } }
    }
    # ...and the definition IS named `adapter`, so §10.1's "the definition
    # that comes back must be named what was asked for" is satisfied by
    # the ref rather than by the probe it borrowed.
    {
      in: [
        { do: 'define', name: 'adapter', probe: 'probe' }
        { do: 'ready', ref: 'adapter$a' }
        { do: 'list' }
      ]
      match: { out: { result: { 'adapter$a': 'live' } } }
    }
  ]


  shape: set: [
    {
      id: 'declare/shape#at-registration', doc: true
      in: [ { do: 'define', name: 'probe', shape: { m: { '$MERGE': { deep: 0 } } } } ]
      err: true, match: { err: { code: 'plugin_shape_invalid' } }
    }
    {
      in: [ { do: 'define', name: 'probe', shape: { m: { '$MERGE': 'merge' } } } ]
      err: true, match: { err: { code: 'plugin_shape_invalid' } }
    }
    # A REJECTED REGISTRATION LEAVES NOTHING BEHIND. Without this, a port
    # could store the definition and then raise, and the next `load`
    # would quietly succeed against a definition the catalog was told to
    # refuse. `catch` lets the run continue past the raise so the second
    # command can ask.
    {
      id: 'declare/shape#rejected-not-registered'
      in: [
        { do: 'define', name: 'shaped', shape: { m: { '$MERGE': { deep: 0 } } }, catch: true }
        { do: 'load', ref: 'shaped$a' }
      ]
      err: true, match: { err: { code: 'plugin_unknown_definition' } }
    }
    {
      id: 'declare/shape#reaches-resolution', doc: true
      in: [
        { do: 'define', name: 'probe', shape: { wrap: 'S' } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'Sx' } }
    }
    # The same run WITHOUT the shape, because 'Sx' alone does not say
    # where the S came from.
    {
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: ':x' } }
    }
    # A $MERGE DIRECTIVE FROM THE CATALOG DRIVES THE MERGE. The pair
    # above only moves a default; this moves the merge rule itself, which
    # is what the shape is for. `provides` is a list, so the library
    # default REPLACES it and the instance's `b` would be the only
    # capability; `append` keeps the document default's `a` as well.
    {
      id: 'declare/shape#directive-at-apply'
      in: [
        { do: 'define', name: 'probe', shape: { provides: { '$MERGE': 'append' } } }
        { do: 'apply', doc: { plugin: 1
            default: { probe: { options: { provides: [ { name: 'a' } ] } } }
            instance: { 'probe$x': { options: { provides: [ { name: 'b' } ] } } } } }
        { do: 'capability', name: 'a' }
      ]
      match: { out: { result: ['probe$x'] } }
    }
    { in: [
        { do: 'apply', doc: { plugin: 1
            default: { probe: { options: { provides: [ { name: 'a' } ] } } }
            instance: { 'probe$x': { options: { provides: [ { name: 'b' } ] } } } } }
        { do: 'capability', name: 'a' }
      ]
      match: { out: { result: [] } } }
  ]
}


# ---------------------------------------------------------------------------
# state — persistence across activation cycles, destruction on unload (§5.4).
# ---------------------------------------------------------------------------

primary: state: {

  survive: set: [
    {
      id: 'state/survive#cycle', doc: true
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'bump' }
        { do: 'deactivate', ref: 'probe$a' }
        { do: 'activate', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'count' }
      ]
      match: { out: { result: 1 } }
    }
    {
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'bump' }
        { do: 'deactivate', ref: 'probe$a' }
        { do: 'activate', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'bump' }
        { do: 'deactivate', ref: 'probe$a' }
        { do: 'activate', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'count' }
      ]
      match: { out: { result: 2 } }
    }
    # UNLOAD DESTROYS IT. Going back to absent means "as if never
    # loaded", and `close` is what properly undoes `define`.
    {
      id: 'state/survive#unload-destroys'
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'bump' }
        { do: 'unload', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'count' }
      ]
      match: { out: { result: 0 } }
    }
    {
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b' }
        { do: 'call', ref: 'probe$a', method: 'bump' }
        { do: 'call', ref: 'probe$b', method: 'count' }
      ]
      match: { out: { result: 0 } }
    }
  ]
}



primary: resource: {

  scope: set: [
    {
      id: 'resource/scope#difference', doc: true
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy', options: { acquire: 3, release: 1 } }
      ]
      match: { out: { open: 2 } }
    }
    # Deactivation unwinds the rest — the scope's job, not a ledger the
    # plugin has to remember to keep.
    {
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy', options: { acquire: 3, release: 1 } }
        { do: 'deactivate', ref: 'greedy$a' }
      ]
      match: { out: { open: 0 } }
    }
    # Releasing everything explicitly leaves nothing to unwind, and
    # unwinding an already-released handle is a NO-OP rather than a
    # double-free — releasing early must not make teardown wrong.
    {
      id: 'resource/scope#double-release'
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy', options: { acquire: 2, release: 2 } }
        { do: 'deactivate', ref: 'greedy$a' }
      ]
      match: { out: { open: 0 } }
    }
    # A PARTIAL ACTIVATION ROLLS BACK. The probe acquires before it
    # raises, so a port that unwinds only on the clean path leaks here.
    {
      id: 'resource/scope#partial-rollback'
      in: [
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
      ]
      match: { out: { open: 0 } }
    }
    {
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy', options: { acquire: 3 } }
        { do: 'ready', ref: 'probe$b' }
        { do: 'close' }
      ]
      match: { out: { open: 0, status: {} } }
    }
    {
      id: 'resource/scope#reverse'
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy', options: { mark: 3 } }
        { do: 'deactivate', ref: 'greedy$a' }
        { do: 'call', ref: 'greedy$a', method: 'unwound' }
      ]
      match: { out: { result: [2, 1, 0] } }
    }
    {
      id: 'resource/scope#release-counts'
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy', options: { mark: 3 } }
      ]
      match: { out: { open: 3 } }
    }
    {
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy', options: { mark: 3 } }
        { do: 'deactivate', ref: 'greedy$a' }
      ]
      match: { out: { open: 0 } }
    }
    # ...and a host close unwinds them too, which is the case the leak
    # made unreachable.
    {
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy', options: { acquire: 2, mark: 2 } }
        { do: 'close' }
      ]
      match: { out: { open: 0, status: {} } }
    }
    {
      id: 'resource/scope#stray'
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'stray' }
      ]
      err: true, match: { err: { code: 'plugin_release_scope' } }
    }
    { in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'call', ref: 'probe$a', method: 'stray', catch: true }
      ]
      match: { out: { open: 1 } } }

    {
      id: 'resource/scope#capture-phase'
      in: [
        { do: 'load', ref: 'greedy$a', definition: 'greedy', options: { early: 'acquire' } }
      ]
      err: true, match: { err: { code: 'plugin_release_scope' } }
    }
    # `release` carries the guard separately, so it needs its own entry:
    # a port fixing one and leaving the other would pass the row above.
    {
      in: [
        { do: 'load', ref: 'greedy$a', definition: 'greedy', options: { early: 'release' } }
      ]
      err: true, match: { err: { code: 'plugin_release_scope' } }
    }

    {
      id: 'resource/scope#release-failed'
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy'
          options: { mark: 2, markfail: true } }
        { do: 'deactivate', ref: 'greedy$a' }
      ]
      err: true, match: { err: { code: 'plugin_release_failed' } }
    }
    # EVERY entry still runs - the count returns to zero even though both
    # releases raised - and the instance ends in `failed`, not `loaded`.
    {
      in: [
        { do: 'ready', ref: 'greedy$a', definition: 'greedy'
          options: { mark: 2, markfail: true } }
        { do: 'deactivate', ref: 'greedy$a', catch: true }
      ]
      match: { out: { open: 0, status: { 'greedy$a': 'failed' } } }
    }
  ]
}



primary: nest: {

  lifetime: set: [
    {
      id: 'nest/lifetime#inner-live', doc: true
      in: [
        { do: 'ready', ref: 'probe$outer', options: { nest: ['probe$inner'] } }
        { do: 'inner', ref: 'probe$outer' }
      ]
      match: { out: { result: { 'probe$inner': 'live' } } }
    }
    # DEACTIVATING THE OUTER CLOSES THE INNER — in the same reverse
    # unwind as every other resource, because that is what "owns the
    # lifetime" has to mean to be more than a sentence.
    {
      id: 'nest/lifetime#outer-closes-inner'
      in: [
        { do: 'ready', ref: 'probe$outer', options: { nest: ['probe$inner'] } }
        { do: 'deactivate', ref: 'probe$outer' }
        { do: 'inner', ref: 'probe$outer' }
      ]
      match: { out: { result: {} } }
    }
    {
      id: 'nest/lifetime#isolated'
      in: [ { do: 'ready', ref: 'probe$outer', options: { nest: ['probe$inner'] } } ]
      match: { out: { status: { 'probe$outer': 'live' } } }
    }
  ]


  open: set: [
    {
      id: 'nest/open#nest-is-not-a-resource', doc: true
      in: [ { do: 'ready', ref: 'probe$outer', options: { nest: ['probe$inner'] } } ]
      match: { out: { open: 1 } }
    }
    # THE SAME NUMBER AS WITHOUT THE NEST, which is the half that says
    # `open: 1` above is the outer's own `acquire` rather than a nest
    # that happens to cost one.
    {
      in: [ { do: 'ready', ref: 'probe$a' } ]
      match: { out: { open: 1 } }
    }
    {
      id: 'nest/open#inner-resources-stay-inner'
      in: [ { do: 'ready', ref: 'probe$outer', options: { nest: ['probe$i1', 'probe$i2'] } } ]
      match: { out: { open: 1 } }
    }
    # ...and the outer's deactivation returns it to zero, closing the
    # inner host on the way. `nest/lifetime#outer-closes-inner` asserts
    # the inner is gone; this asserts nothing was left held.
    {
      id: 'nest/open#unwinds'
      in: [
        { do: 'ready', ref: 'probe$outer', options: { nest: ['probe$i1', 'probe$i2'] } }
        { do: 'deactivate', ref: 'probe$outer' }
      ]
      match: { out: { open: 0 } }
    }
  ]
}


# ---------------------------------------------------------------------------
# trace — the lifecycle event records (§14).
# ---------------------------------------------------------------------------

primary: trace: {

  record: set: [
    {
      id: 'trace/record#forward', doc: true
      in: [ { do: 'ready', ref: 'probe$a' }, { do: 'trace' } ]
      match: { out: { result: [
        { ref: 'probe$a', event: 'define' }
        { ref: 'probe$a', event: 'activate' }
      ] } }
    }
    # `seq` IS ON THE RECORD, which is the whole reason it exists: it
    # distinguishes one incarnation of an instance from the next in a
    # trace, where `pos` would be identical for both.
    {
      id: 'trace/record#seq'
      in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'unload', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$a' }
        { do: 'trace' }
      ]
      match: { out: { result: [
        { ref: 'probe$a', event: 'define', seq: 0 }
        { ref: 'probe$a', event: 'activate', seq: 0 }
        { ref: 'probe$a', event: 'deactivate', seq: 0 }
        { ref: 'probe$a', event: 'close', seq: 0 }
        { ref: 'probe$a', event: 'define', seq: 1 }
        { ref: 'probe$a', event: 'activate', seq: 1 }
      ] } }
    }
  ]
}



primary: apply: {

  idempotent: set: [
    {
      id: 'apply/idempotent#twice', doc: true
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
      ]
      out: { status: { 'probe$a': 'live' }, open: 1
             log: ['probe$a:define', 'probe$a:activate'], result: null }
    }
    # The LOG is the assertion, not the status: a port that re-ran
    # `define` would end in the same state and be wrong.
    {
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { start: 'lazy' } } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { start: 'lazy' } } } }
      ]
      match: { out: { log: [] } }
    }
    {
      id: 'apply/idempotent#options-first-time', doc: true
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { options: { wrap: 'W' } } } } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'Wx' } }
    }
    # ...and are still there after a second, identical apply — the fix
    # must not trade the first apply for the second.
    {
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { options: { wrap: 'W' } } } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { options: { wrap: 'W' } } } } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'Wx' } }
    }
    # A re-apply that CHANGES the value still lands, which is what the
    # refill exists for: the binding closed over the map at `define`.
    {
      id: 'apply/idempotent#options-changed'
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { options: { wrap: 'W' } } } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { options: { wrap: 'Z' } } } } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'Zx' } }
    }
  ]


  gone: set: [
    {
      id: 'apply/gone#dropped', doc: true
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {}, 'probe$b': {} } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
      ]
      match: { out: { status: { 'probe$a': 'live' } } }
    }
    # It is UNLOADED, not merely deactivated: `probe$b` is absent from
    # the status map entirely, and its resource is released.
    {
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {}, 'probe$b': {} } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'list' }
      ]
      match: { out: { result: { 'probe$b': '__UNDEF__' }, open: 1 } }
    }
    {
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'apply', doc: { plugin: 1, instance: {} } }
      ]
      match: { out: { open: 0, status: {}
                      log: ['probe$a:define', 'probe$a:activate'
                            'probe$a:deactivate', 'probe$a:close'] } }
    }
    # A ref that was only ever `declared` is left alone rather than
    # unloaded, because there is nothing to undo and `unload` would run
    # `close` on an instance that never ran `define`.
    {
      id: 'apply/gone#declared-untouched'
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { start: 'lazy' } } } }
        { do: 'apply', doc: { plugin: 1, instance: {} } }
      ]
      match: { out: { log: [], status: { 'probe$a': 'declared' } } }
    }
  ]


  phases: set: [
    {
      id: 'apply/phases#declare-all-then-activate', doc: true
      in: [
        { do: 'apply', doc: { plugin: 1, instance: [ { ref: 'probe$a' }, { ref: 'probe$b' } ] } }
      ]
      match: { out: { log: ['probe$a:define', 'probe$b:define'
                            'probe$a:activate', 'probe$b:activate'] } }
    }
    # Unloads come FIRST and in REVERSE load order, so a consumer
    # declared after its provider goes down before it.
    {
      id: 'apply/phases#reverse-teardown'
      in: [
        { do: 'apply', doc: { plugin: 1, instance: [ { ref: 'probe$a' }, { ref: 'probe$b' } ] } }
        { do: 'apply', doc: { plugin: 1, instance: [ { ref: 'probe$c' } ] } }
      ]
      match: { out: { log: ['probe$a:define', 'probe$b:define'
                            'probe$a:activate', 'probe$b:activate'
                            'probe$b:deactivate', 'probe$b:close'
                            'probe$a:deactivate', 'probe$a:close'
                            'probe$c:define', 'probe$c:activate'] } }
    }
  ]

  change: set: [
    {
      id: 'apply/change#add', doc: true
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {}, 'probe$b': {} } } }
      ]
      match: { out: { status: { 'probe$a': 'live', 'probe$b': 'live' } } }
    }
    {
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { options: { wrap: 'A' } } } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { options: { wrap: 'Z' } } } } }
        { do: 'chain', point: 'c', arg: 'x' }
      ]
      match: { out: { result: 'Zx' } }
    }
    {
      id: 'apply/change#toggle-off'
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { active: false } } } }
      ]
      match: { out: { status: { 'probe$a': 'declared' }, open: 0 } }
    }
    {
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { active: false } } } }
      ]
      match: { out: { log: [
        'probe$a:define', 'probe$a:activate', 'probe$a:deactivate', 'probe$a:close' ] } }
    }
    {
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { start: 'lazy' } } } }
      ]
      match: { out: { status: { 'probe$a': 'declared' } } }
    }
    {
      id: 'apply/change#toggle-back'
      in: [
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': { active: false } } } }
        { do: 'apply', doc: { plugin: 1, instance: { 'probe$a': {} } } }
      ]
      match: { out: { status: { 'probe$a': 'live' }, open: 1 } }
    }
  ]


  # A document with a PROFILE selected applies the overlay, and the
  # defaults-after-merge rule holds through `apply` exactly as it does
  # through normalizeconfig — the safety rule is not lost between the
  # pure function and the host that calls it.
  profile: set: [
    {
      id: 'apply/profile#bar-survives', doc: true
      in: [
        { do: 'apply', profile: 'prod', doc: {
          plugin: 1
          instance: { 'probe$a': { active: false } }
          profile: { prod: { instance: { 'probe$a': { options: { wrap: 'P' } } } } } } }
      ]
      match: { out: { status: { 'probe$a': 'declared' } } }
    }
  ]
}



primary: error: {

  format: set: [
    {
      id: 'error/format#prefix', doc: true
      in: [ { do: 'activate', ref: 'nope$a' } ]
      err: true, match: { err: { message: '/^plugin\\/plugin_not_loaded: /' } }
    }
    {
      in: [ { do: 'activate', ref: 'nope$a' } ]
      err: true, match: { err: { message: '/\\[ref="nope\\$a"\\]/' } }
    }
    # Values render as COMPACT JSON — quoted, so a ref containing a
    # space or a bracket cannot break a parser reading the line.
    {
      id: 'error/format#json-values'
      in: [ { do: 'emit', point: 'nope' } ]
      err: true, match: { err: { message: '/\\[point="nope"\\]/' } }
    }
    {
      id: 'error/format#list-field'
      in: [
        { do: 'ready', ref: 'probe$a', order: { after: 'probe$b' } }
        { do: 'ready', ref: 'probe$b', order: { after: 'probe$a' } }
        { do: 'order', point: 'p' }
      ]
      err: true, match: { err: { message: '/cycle=\\[/' } }
    }
  ]


  codes: set: [
    { id: 'error/codes#not-loaded', doc: true
      in: [ { do: 'activate', ref: 'nope$a' } ], err: true, match: { err: { code: 'plugin_not_loaded' } } }
    { in: [ { do: 'load', ref: 'nosuch$a' } ], err: true, match: { err: { code: 'plugin_unknown_definition' } } }
    { in: [
        { do: 'load', ref: 'probe$a' }
        { do: 'load', ref: 'probe$a', definition: 'other' }
      ], err: true, match: { err: { code: 'plugin_ref_duplicate' } } }
    { in: [ { do: 'emit', point: 'nope' } ], err: true, match: { err: { code: 'plugin_point_unknown' } } }
    { in: [ { do: 'chain', point: 'p' } ], err: true, match: { err: { code: 'plugin_point_kind' } } }
    { in: [
        { do: 'ready', ref: 'probe$a', order: { after: 'probe$a' } }
        { do: 'order', point: 'p' }
      ], err: true, match: { err: { code: 'plugin_order_cycle' } } }
    { in: [
        { do: 'load', ref: 'noisy$a', options: { fail: 'activate' } }
        { do: 'activate', ref: 'noisy$a', catch: true }
        { do: 'activate', ref: 'noisy$a' }
      ], err: true, match: { err: { code: 'plugin_bad_state' } } }
    { in: [
        { do: 'load', ref: 'noisy$a', options: { reenter: 'activate' } }
        { do: 'activate', ref: 'noisy$a' }
      ], err: true, match: { err: { code: 'plugin_reentrant' } } }
    { in: [
        { do: 'ready', ref: 'probe$a' }
        { do: 'ready', ref: 'probe$b' }
        { do: 'export', key: 'probe/client' }
      ], err: true, match: { err: { code: 'plugin_export_ambiguous' } } }
    { in: [
        { do: 'host', points: { v: { kind: 'provider', exclusive: true } } }
        { do: 'ready', ref: 'provider$a', definition: 'provider', options: { point: 'v' } }
        { do: 'ready', ref: 'provider$b', definition: 'provider', options: { point: 'v' } }
        { do: 'provider', point: 'v' }
      ], err: true, match: { err: { code: 'plugin_point_exclusive' } } }
    { in: [
        { do: 'host', reserved: ['station'] }
        { do: 'declare', ref: 'station$a' }
      ], err: true, match: { err: { code: 'plugin_ref_reserved' } } }

    { id: 'error/codes#reserved-host-path'
      in: [
        { do: 'host', reserved: ['probe'] }
        { do: 'hostdeclare', ref: 'probe$a' }
      ], match: { out: { result: 'probe$a', status: { 'probe$a': 'declared' } } } }
    # ...while the ordinary path to the same ref stays barred, which is
    # what makes the pair an assertion rather than a bypass.
    { in: [
        { do: 'host', reserved: ['probe'] }
        { do: 'declare', ref: 'probe$a' }
      ], err: true, match: { err: { code: 'plugin_ref_reserved' } } }
  ]
}
