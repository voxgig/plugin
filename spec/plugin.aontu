
# The plugin conformance corpus — SOURCE OF TRUTH.
#
# plugin.json beside this file is a COMMITTED build artifact compiled from
# here by tools/build-spec.js (@voxgig/model). Every port's test runner
# reads that JSON directly, so no port needs a Node toolchain to run its
# tests. Edit this file, run `npm run build-spec` in tools/, and commit
# both. Never hand-edit the JSON (§16, prime directive 5).
#
# THIS CORPUS IS EMPTY, AND THAT IS P0's EXIT CRITERION.
#
# P0 builds the machinery and proves it turns over: `make spec` compiles
# this file and `make spec-check` proves the committed JSON matches it.
# Both must work before there is anything to compile, because a corpus
# pipeline first exercised on real data is one whose failures arrive mixed
# up with the data's.
#
# P1 fills it in, and the order is an obligation rather than a preference
# (see station's station-and-plugin-plan.md §3):
#
#   C1, owed BEFORE station's Stage 2 — earlier than P1's own exit:
#     ref      name/tag grammar, parse, format, canonicalization,
#              auto-tag, `pos` vs `seq` across a redeclaration
#     config   document normalization, array/map forms, the `default`
#              map, the ten-level precedence ladder, profile overlay,
#              defaults-after-merge, shape-declared merge depth,
#              list-replace
#
#   C2, owed before P1's exit, together with the draft driver contract in
#   DOCS.md (§15.2 — probes, command vocabulary, canonical observable),
#   because these two are DRIVER sections and a port cannot run them from
#   corpus files alone:
#     lifecycle  the state machine, idempotence, illegal transitions,
#                failure paths
#     order      topological sort, bands, ties, vacuous constraints,
#                recomputation
#
# The remaining sections (§15.3) land with the phase that implements them:
# env, resolve, capability, version, graph, declare, nest, state,
# resource, point, export, depend, apply, error, trace.
#
# Adding a section here is not enough on its own — §15.3's table records
# whether it is pure data or driver-based, and a driver section without
# its contract in DOCS.md is a suite no port but this one can implement.


# Spec format version. Version 1 turns on strict entry validation in every
# runner: unknown fields, multiple argument sources, `err` beside `out`,
# and empty sets all fail rather than passing silently.
PLUGIN: version: 1


# ---------------------------------------------------------------------------
# ref — name/tag identity. THE FIRST SECTION A PORT PASSES.
#
# Pure (§15.3): every entry calls one of the four pure functions, so a port
# runs this with no host and no driver contract. That is what makes it
# deliverable to station ahead of its Stage 2 (C1) — see doc/plan/contracts.md.
#
# The group name selects the subject:
#   parse / parsebad   parseref(str)      -> {name, tag}
#   format / formatbad formatref(name,tag)-> str        (positional args)
#   canon              formatref(parseref(str))         -> str
#   name               checkname(str)     -> boolean
#   tag                checktag(str)      -> boolean
#   bound              the 1024-character limit, both functions
#
# GRAMMAR (§4), and the asymmetry between the two is deliberate:
#   name  ^[a-zA-Z@][a-zA-Z0-9.~_\-/]*$   max 1024
#   tag   ^[a-zA-Z0-9.~_-]+$              max 1024, or empty
# A tag may START WITH A DIGIT and a name may not, because auto-tagging
# assigns integer tags (stripe$1). A tag admits neither `@` nor `/`, because
# a name is a package specifier and a tag is not.
#
# TWO THINGS THIS SECTION PINS THAT THE PROSE DOES NOT STATE:
#
# 1. `a$b$c` splits on the FIRST `$`, giving name `a` and tag `b$c`, so it
#    fails as plugin_bad_tag rather than plugin_bad_name. Splitting on the
#    last `$` would be equally consistent with §4 and would blame the name.
#    Neither reading is derivable from the grammar — `$` is in neither
#    character class — so the corpus is the arbiter (§4 rule 5), and it
#    chooses the error that names the part actually at fault.
#
# 2. The empty string is plugin_bad_name, not a name with an empty tag.
#
# WHAT THIS SECTION DOES NOT PIN, and why it is not an oversight:
# §15.3 lists `ref` as also covering **auto-tag** and **`pos` vs `seq`
# across a redeclaration**. Neither is reachable from the canonical pure
# surface — there is no `autotag` function, `seq` is by definition a
# counter held by the host, and `pos` is assigned by document
# normalization. Pinning them here would make a section marked `pure`
# require a driver, which would put C1 behind C2 and break the ordering
# station's Stage 2 depends on. They are tracked in
# doc/plan/handover.md §6 and belong to `config` and the driver sections.
# ---------------------------------------------------------------------------

primary: ref: {

  # The pair, from the written form. The tag is '' when absent — never null,
  # never missing, because a port that returns three shapes for two states
  # makes every downstream comparison a special case.
  parse: set: [
    { id: 'ref/parse#bare', doc: true, in: 'stripe', out: { name: 'stripe', tag: '' } }
    { in: 'stripe$test', out: { name: 'stripe', tag: 'test' } }
    { in: 'retry$fast', out: { name: 'retry', tag: 'fast' } }

    # Canonicalization: a trailing `$` is an empty tag written out loud.
    { in: 'stripe$', out: { name: 'stripe', tag: '' } }

    # A name is a package specifier, so it carries @ / . - _ ~
    { in: '@voxgig/plugin-retry', out: { name: '@voxgig/plugin-retry', tag: '' } }
    { in: '@voxgig/plugin-retry$eu', out: { name: '@voxgig/plugin-retry', tag: 'eu' } }
    { in: 'a.b.c', out: { name: 'a.b.c', tag: '' } }
    { in: 'a_b-c~d', out: { name: 'a_b-c~d', tag: '' } }
    { in: 'a/b/c$x', out: { name: 'a/b/c', tag: 'x' } }
    { in: 'A', out: { name: 'A', tag: '' } }
    { in: 'a1', out: { name: 'a1', tag: '' } }

    # Integer tags are what auto-tagging assigns, so they must parse as
    # ordinary tags — nothing distinguishes stripe$1 from stripe$test here.
    { in: 'stripe$1', out: { name: 'stripe', tag: '1' } }
    { in: 'stripe$0', out: { name: 'stripe', tag: '0' } }
    { in: 'stripe$99', out: { name: 'stripe', tag: '99' } }
    { in: 'x$a.b', out: { name: 'x', tag: 'a.b' } }
    { in: 'x$a_b-c~d', out: { name: 'x', tag: 'a_b-c~d' } }
  ]


  # Grammar violations. The code says which HALF is wrong, which is the
  # whole reason there are two codes rather than one plugin_bad_ref.
  parsebad: set: [
    { id: 'ref/parsebad#empty', doc: true, in: '', err: 'plugin_bad_name' }
    { in: '$test', err: 'plugin_bad_name' }
    { in: '$', err: 'plugin_bad_name' }
    { in: '1abc', err: 'plugin_bad_name' }
    { in: '-abc', err: 'plugin_bad_name' }
    { in: '.abc', err: 'plugin_bad_name' }
    { in: '/abc', err: 'plugin_bad_name' }
    { in: '~abc', err: 'plugin_bad_name' }
    { in: '_abc', err: 'plugin_bad_name' }
    { in: 'a b', err: 'plugin_bad_name' }
    { in: 'a!b', err: 'plugin_bad_name' }
    { in: 'a#b', err: 'plugin_bad_name' }

    # Splits on the FIRST `$`, so the name is `a` and the tag is `b$c`.
    # See the header note: this is a corpus decision, not a grammar one.
    { in: 'a$b$c', err: 'plugin_bad_tag' }
    { in: 'a$b/c', err: 'plugin_bad_tag' }
    { in: 'a$@b', err: 'plugin_bad_tag' }
    { in: 'a$b c', err: 'plugin_bad_tag' }
    { in: 'a$b!c', err: 'plugin_bad_tag' }
  ]


  # The written form, from the pair. Positional args: [name, tag].
  format: set: [
    { id: 'ref/format#bare', doc: true, args: ['stripe', ''], out: 'stripe' }
    { args: ['stripe', 'test'], out: 'stripe$test' }
    { args: ['@voxgig/plugin-retry', 'eu'], out: '@voxgig/plugin-retry$eu' }
    { args: ['stripe', '1'], out: 'stripe$1' }
    { args: ['a.b.c', 'x~y'], out: 'a.b.c$x~y' }

    # An empty tag NEVER writes the separator. This is the half of
    # canonicalization that formatref owns: parse tolerates `stripe$`,
    # format never produces it, so a round trip is idempotent.
    { args: ['stripe', ''], out: 'stripe' }
  ]


  formatbad: set: [
    { id: 'ref/formatbad#emptyname', doc: true, args: ['', ''], err: 'plugin_bad_name' }
    { args: ['', 'test'], err: 'plugin_bad_name' }
    { args: ['1abc', ''], err: 'plugin_bad_name' }
    { args: ['a$b', ''], err: 'plugin_bad_name' }
    { args: ['stripe', 'a/b'], err: 'plugin_bad_tag' }
    { args: ['stripe', 'a$b'], err: 'plugin_bad_tag' }
    { args: ['stripe', '@x'], err: 'plugin_bad_tag' }
  ]


  # formatref(parseref(s)) — the canonical spelling of s. §4 rule 5: ports
  # must canonicalize before comparison, and this group is the arbiter.
  # Every entry is also an idempotence check, because the output of canon
  # is itself a valid input to canon.
  canon: set: [
    { id: 'ref/canon#trailing', doc: true, in: 'stripe$', out: 'stripe' }
    { in: 'stripe', out: 'stripe' }
    { in: 'stripe$test', out: 'stripe$test' }
    { in: '@voxgig/plugin-retry$', out: '@voxgig/plugin-retry' }
    { in: 'a.b.c$1', out: 'a.b.c$1' }
  ]


  # checkname(str) -> boolean. A predicate, not a raiser: the caller that
  # wants an error has parseref for that.
  name: set: [
    { id: 'ref/name#simple', doc: true, in: 'stripe', out: true }
    { in: 'a', out: true }
    { in: 'A', out: true }
    { in: '@scope/pkg', out: true }
    { in: '@voxgig/plugin-retry', out: true }
    { in: 'a.b.c', out: true }
    { in: 'a_b', out: true }
    { in: 'a-b', out: true }
    { in: 'a~b', out: true }
    { in: 'a/b', out: true }
    { in: 'a1', out: true }
    { in: 'a123._~-/', out: true }

    { in: '', out: false }
    { in: '1a', out: false }
    { in: '-a', out: false }
    { in: '.a', out: false }
    { in: '_a', out: false }
    { in: '~a', out: false }
    { in: '/a', out: false }
    { in: 'a$b', out: false }
    { in: 'a b', out: false }
    { in: 'a!b', out: false }
    { in: 'a%b', out: false }
  ]


  # checktag(str) -> boolean. The empty tag is VALID and ordinary (§4 rule
  # 2) — the single-instance case writes no tag and never learns tags exist.
  tag: set: [
    { id: 'ref/tag#empty', doc: true, in: '', out: true }
    { in: 'test', out: true }
    { in: '1', out: true }
    { in: '0', out: true }
    { in: '99', out: true }
    { in: 'a.b', out: true }
    { in: 'a_b', out: true }
    { in: 'a-b', out: true }
    { in: 'a~b', out: true }
    { in: 'A1._~-', out: true }

    # A tag is not a package specifier: no @, no /.
    { in: '@x', out: false }
    { in: 'a/b', out: false }
    { in: 'a$b', out: false }
    { in: 'a b', out: false }
    { in: 'a!b', out: false }
  ]


  # The 1024-character bound, pinned at the boundary in both directions.
  # A bound stated in prose and absent from the corpus is not a contract,
  # and off-by-one at a length limit is the classic per-port divergence.
  bound: set: [
    { id: 'ref/bound#name-max', doc: true, in: '', out: true }
    { in: '', out: false }
  ]


  # checktag at the same boundary. Separate group because the subject
  # differs — `bound` runs checkname, `boundtag` runs checktag.
  boundtag: set: [
    { id: 'ref/boundtag#max', doc: true, in: '', out: true }
    { in: '', out: false }
  ]
}


# ---------------------------------------------------------------------------
# config — the declarative document, and the precedence ladder.
#
# Pure (§15.3): normalization is a pure function of the document, and option
# resolution is a pure function of its layers. No host, no driver. The other
# half of C1 — see doc/plan/contracts.md.
#
# TWO SUBJECTS, selected by group prefix, and BOTH TAKE ONE NAMED-LAYER MAP
# as `in`:
#
#   norm*   normalizeconfig({ doc, profile?, keys?, reserved? })
#             -> { instance, order, default, ... }
#           `order` is the load order: array position for the array form,
#           sorted refs for the map form.
#
#   opt*    resolveoptions({ ref, shape?, hostdefaults?, doc?, profile?,
#                            env?, hostoptions?, loadoptions?, patch? })
#             -> the resolved option map
#
#           mapping onto §9.3's levels 1-10 as
#             shape(1) hostdefaults(2) doc.default(3) doc.instance(4)
#             doc.profile.<p>.default(5) doc.profile.<p>.instance(6)
#             env(7) hostoptions(8) loadoptions(9) patch(10).
#
# An entry supplies only the layers it exercises, so the ladder is visible in
# the test data rather than implied by call order.
#
# THE INPUT SHAPE IS A CORPUS DECISION. §9.3 fixes the ORDER of the ten
# levels and §9.2 the API's existence, but not how a caller hands them over.
# One named map keeps every entry self-describing, lets a port implement
# resolveoptions without also implementing a host, and keeps the host
# settings (`keys`, `reserved`, `profile`) inside `in` where inputs belong —
# the shared Entry shape is CLOSED and stays omni's, because a second
# description of one format is a second thing to drift.
#
# ONE AONTU CONSTRAINT WORTH KNOWING: a bare key cannot contain `$`, so
# every ref used as a map key here is quoted ('stripe$test': …), as is
# '$MERGE'. Unquoted, it is a parse error rather than a subtly different
# key, so this is a build-time failure and not a silent one.
# ---------------------------------------------------------------------------

primary: config: {

  # Map form. Load order is the SORTED refs — byte-stable, so output does
  # not depend on the parser's key order.
  normmap: set: [
    {
      id: 'config/normmap#order', doc: true
      in: { doc: { plugin: 1, instance: { retry: {}, alpha: {}, 'memcache$hot': {} } } }
      match: { out: { order: ['alpha', 'memcache$hot', 'retry'] } }
    }
    {
      in: { doc: { plugin: 1, instance: { 'stripe$test': {}, stripe: {}, 'stripe$eu': {} } } }
      match: { out: { order: ['stripe', 'stripe$eu', 'stripe$test'] } }
    }
    # An empty document normalizes to an empty instance map and empty order,
    # not to an error and not to a missing key.
    {
      in: { doc: { plugin: 1 } }
      match: { out: { order: [], instance: {} } }
    }
  ]


  # Array form. The array POSITION is the load order (§9.1) — the same
  # contract as sdkgen's ordered-array feature form.
  normarray: set: [
    {
      id: 'config/normarray#order', doc: true
      in: { doc: { plugin: 1, instance: [ { ref: 'retry' }, { ref: 'alpha' }, { ref: 'memcache$hot' } ] } }
      match: { out: { order: ['retry', 'alpha', 'memcache$hot'] } }
    }
    # The array becomes the same map the map form produces: one normalized
    # shape downstream, whichever form was authored.
    {
      in: { doc: { plugin: 1, instance: [ { ref: 'retry', options: { retries: 3 } } ] } }
      match: { out: { instance: { retry: { options: { retries: 3 } } } } }
    }
    # The ref is canonicalized on the way in, exactly as §4 rule 5 requires.
    {
      in: { doc: { plugin: 1, instance: [ { ref: 'stripe$' } ] } }
      match: { out: { order: ['stripe'] } }
    }
  ]


  # A PARTIAL ARRAY IS NOT A FILTER (§9.1). sdkgen learned this the hard
  # way: deriving order from a partial array silently dropped
  # config-activated features. Refs in the base map but absent from the
  # array still load, in sorted position AFTER the listed ones.
  normpartial: set: [
    {
      id: 'config/normpartial#keep', doc: true
      in: {
        profile: 'dev'
        doc: {
          plugin: 1
          instance: { retry: {}, alpha: {}, zeta: {} }
          profile: { dev: { instance: [ { ref: 'zeta' } ] } }
        }
      }
      match: { out: { order: ['zeta', 'alpha', 'retry'] } }
    }
    # Nothing is dropped: the instance map still carries all three.
    {
      in: {
        profile: 'dev'
        doc: {
          plugin: 1
          instance: { retry: {}, alpha: {}, zeta: {} }
          profile: { dev: { instance: [ { ref: 'zeta' } ] } }
        }
      }
      match: { out: { instance: { retry: '__EXISTS__', alpha: '__EXISTS__', zeta: '__EXISTS__' } } }
    }
  ]


  # DEFAULTS ARE APPLIED AFTER THE MERGE, NEVER BEFORE IT (§9.3).
  # A safety rule, not a tidiness one, and the first entry is the case
  # station supplied that shows why.
  normdefaults: set: [
    # A base that BARS an instance, and an overlay that only moves a URL.
    # If the overlay had its defaults filled in before merging it would
    # carry a synthesized active:true and overwrite the base's false —
    # silently re-enabling a deliberately disabled integration in prod.
    {
      id: 'config/normdefaults#bar', doc: true
      in: {
        profile: 'prod'
        doc: {
          plugin: 1
          instance: { 'pad$a': { active: false } }
          profile: { prod: { instance: { 'pad$a': { options: { base: 'https://prod.example' } } } } }
        }
      }
      match: { out: { instance: { 'pad$a': { active: false, options: { base: 'https://prod.example' } } } } }
    }
    # The defaults themselves, on a merged entry that states neither.
    {
      in: { doc: { plugin: 1, instance: { retry: {} } } }
      match: { out: { instance: { retry: { active: true, start: 'eager' } } } }
    }
    # An authored value is never overwritten by its own default.
    {
      in: { doc: { plugin: 1, instance: { retry: { active: false, start: 'lazy' } } } }
      match: { out: { instance: { retry: { active: false, start: 'lazy' } } } }
    }
    # The same rule one level down, for a host nesting an instance map
    # inside an option (§6.5) — the identical defect with a different key.
    {
      in: {
        profile: 'prod'
        doc: {
          plugin: 1
          instance: { outer: { options: { instance: { inner: { active: false } } } } }
          profile: { prod: { instance: { outer: { options: { instance: { inner: { options: { x: 1 } } } } } } } }
        }
      }
      match: { out: { instance: { outer: { options: { instance: { inner: { active: false } } } } } } }
    }
  ]


  # Host key renaming (§9.1). Applied at TWO PLACES AND NO OTHERS: the
  # document root, and every profile.<name> overlay root. Neither recurses.
  normkeys: set: [
    {
      id: 'config/normkeys#root', doc: true
      in: {
        keys: { instance: 'sdk', default: 'api' }
        doc: { plugin: 1, sdk: { retry: {} }, api: { retry: { options: { t: 1 } } } }
      }
      match: { out: { order: ['retry'] } }
    }
    # The profile overlay root too. A rename applied only at the document
    # root would leave profile.prod.sdk untranslated and SILENTLY DROP
    # every environment override the host depends on.
    {
      in: {
        keys: { instance: 'sdk', default: 'api' }
        profile: 'prod'
        doc: {
          plugin: 1
          sdk: { retry: { options: { t: 1 } } }
          profile: { prod: { sdk: { retry: { options: { t: 2 } } } } }
        }
      }
      match: { out: { instance: { retry: { options: { t: 2 } } } } }
    }
    # It does NOT recurse: option data belongs to the definition, and a
    # host's key map has no business rewriting keys inside it. An option
    # literally named `sdk` survives untouched.
    {
      in: {
        keys: { instance: 'sdk', default: 'api' }
        doc: { plugin: 1, sdk: { retry: { options: { sdk: 'untouched' } } } }
      }
      match: { out: { instance: { retry: { options: { sdk: 'untouched' } } } } }
    }
  ]


  # Reserved refs (§9.1). A configuration surface that can disable the
  # thing reading it is not a surface, it is a trap. The reservation is
  # all-or-nothing per NAME, so the tagged forms go too.
  normreserved: set: [
    {
      id: 'config/normreserved#doc', doc: true
      in: { reserved: ['station'], doc: { plugin: 1, instance: { station: {} } } }
      err: 'plugin_ref_reserved'
    }
    {
      in: { reserved: ['station'], doc: { plugin: 1, instance: { 'station$eu': {} } } }
      err: 'plugin_ref_reserved'
    }
    {
      in: { reserved: ['station'], doc: { plugin: 1, default: { station: {} } } }
      err: 'plugin_ref_reserved'
    }
    # In a profile overlay too — §9.1 lists every input layer, and a
    # guarantee that holds only at the root is trivially bypassable.
    {
      in: {
        reserved: ['station'], profile: 'prod'
        doc: { plugin: 1, profile: { prod: { instance: { station: {} } } } }
      }
      err: 'plugin_ref_reserved'
    }
    # A name that merely starts with the reserved one is NOT reserved.
    {
      in: { reserved: ['station'], doc: { plugin: 1, instance: { stationary: {} } } }
      match: { out: { order: ['stationary'] } }
    }
  ]


  # §9.3's ten levels, lowest to highest. Each entry adds one level on top
  # of the one below and expects it to win.
  optladder: set: [
    { id: 'config/optladder#1', doc: true
      in: { ref: 'r', shape: { t: 1 } }, out: { t: 1 } }
    { in: { ref: 'r', shape: { t: 1 }, hostdefaults: { t: 2 } }, out: { t: 2 } }
    { in: { ref: 'r', shape: { t: 1 }, hostdefaults: { t: 2 }
            doc: { default: { r: { options: { t: 3 } } } } }, out: { t: 3 } }
    { in: { ref: 'r', doc: { default: { r: { options: { t: 3 } } }
                             instance: { r: { options: { t: 4 } } } } }, out: { t: 4 } }
    { in: { ref: 'r', profile: 'p'
            doc: { instance: { r: { options: { t: 4 } } }
                   profile: { p: { default: { r: { options: { t: 5 } } } } } } }, out: { t: 5 } }
    { in: { ref: 'r', profile: 'p'
            doc: { profile: { p: { default: { r: { options: { t: 5 } } }
                                   instance: { r: { options: { t: 6 } } } } } } }, out: { t: 6 } }
    { in: { ref: 'r', doc: { instance: { r: { options: { t: 4 } } } }, env: { t: 7 } }, out: { t: 7 } }
    { in: { ref: 'r', env: { t: 7 }, hostoptions: { t: 8 } }, out: { t: 8 } }
    { in: { ref: 'r', hostoptions: { t: 8 }, loadoptions: { t: 9 } }, out: { t: 9 } }
    { in: { ref: 'r', loadoptions: { t: 9 }, patch: { t: 10 } }, out: { t: 10 } }
  ]


  # Levels 3-6 are ONE ordered merge, and the order is the point (§9.3):
  # PROFILE SPECIFICITY OUTRANKS DEFINITION SPECIFICITY.
  optprofile: set: [
    # A prod per-definition default BEATS a base instance value — that is
    # what an environment overlay is for. Collapsing the two namespaces
    # and composing them afterwards would invert this.
    {
      id: 'config/optprofile#specificity', doc: true
      in: { ref: 'stripe$test', profile: 'prod'
            doc: { instance: { 'stripe$test': { options: { t: 'base-instance' } } }
                   profile: { prod: { default: { stripe: { options: { t: 'prod-default' } } } } } } }
      out: { t: 'prod-default' }
    }
    # Within one profile the instance beats the definition default —
    # that is what an instance is for.
    {
      in: { ref: 'stripe$test', profile: 'prod'
            doc: { profile: { prod: { default: { stripe: { options: { t: 'prod-default' } } }
                                      instance: { 'stripe$test': { options: { t: 'prod-instance' } } } } } } }
      out: { t: 'prod-instance' }
    }
    # With no `default` entries it degenerates to base then overlay.
    {
      in: { ref: 'r', profile: 'p'
            doc: { instance: { r: { options: { a: 1, b: 1 } } }
                   profile: { p: { instance: { r: { options: { b: 2 } } } } } } }
      out: { a: 1, b: 2 }
    }
    # An unselected profile contributes nothing.
    {
      in: { ref: 'r'
            doc: { instance: { r: { options: { t: 1 } } }
                   profile: { p: { instance: { r: { options: { t: 99 } } } } } } }
      out: { t: 1 }
    }
  ]


  # `default` is keyed by NAME and declares nothing (§9.3).
  optdefault: set: [
    # A base for every instance of that definition.
    {
      id: 'config/optdefault#byname', doc: true
      in: { ref: 'stripe$eu', doc: { default: { stripe: { options: { t: 5000 } } } } }
      out: { t: 5000 }
    }
    { in: { ref: 'stripe$test', doc: { default: { stripe: { options: { t: 5000 } } } } }, out: { t: 5000 } }
    { in: { ref: 'stripe', doc: { default: { stripe: { options: { t: 5000 } } } } }, out: { t: 5000 } }
    # It does not reach a DIFFERENT definition.
    { in: { ref: 'other', doc: { default: { stripe: { options: { t: 5000 } } } } }, out: {} }

    # THE TWO MAPS ARE SEPARATE NAMESPACES, NOT SEPARATE SPELLINGS. An
    # untagged ref IS a bare name, so `default.stripe` and
    # `instance.stripe` are the same key string in two maps; the map
    # decides the meaning. Both may exist for one name.
    {
      in: { ref: 'stripe', doc: { default: { stripe: { options: { a: 'from-default', b: 1 } } }
                                  instance: { stripe: { options: { a: 'from-instance' } } } } }
      out: { a: 'from-instance', b: 1 }
    }
    # And the untagged instance's options apply ONLY to itself — this is
    # what replaced seneca's shortname rule, so a tagged sibling sees the
    # `default` value and not the untagged instance's.
    {
      in: { ref: 'stripe$test', doc: { default: { stripe: { options: { a: 'from-default' } } }
                                       instance: { stripe: { options: { a: 'from-untagged' } } } } }
      out: { a: 'from-default' }
    }
  ]


  # A LIST REPLACES (§9.4). struct.merge is element-wise by index, which
  # for option maps is nearly always wrong: ["a"] over ["x","y","z"]
  # yielding ["a","y","z"] is the defect station hit on secrets.providers.
  optlist: set: [
    {
      id: 'config/optlist#replace', doc: true
      in: { ref: 'r', doc: { default: { r: { options: { p: ['x', 'y', 'z'] } } }
                             instance: { r: { options: { p: ['a'] } } } } }
      out: { p: ['a'] }
    }
    { in: { ref: 'r', doc: { instance: { r: { options: { p: ['x', 'y'] } } } }, patch: { p: [] } }, out: { p: [] } }
    # A map next to it still deep-merges: the rule is about lists, not
    # about turning every merge into a replace.
    {
      in: { ref: 'r', doc: { default: { r: { options: { p: ['x'], m: { a: 1 } } } }
                             instance: { r: { options: { p: ['a'], m: { b: 2 } } } } } }
      out: { p: ['a'], m: { a: 1, b: 2 } }
    }
  ]


  # The option SHAPE declares each key's merge behaviour (§9.4). The
  # library default is deep for maps and replace for lists; the shape is
  # the one place the question is answered, and it travels with the
  # definition rather than living as a table in the host.
  optmerge: set: [
    # replace — station declares `policy` this way to keep an egress
    # allowlist from silently widening because two levels merged.
    {
      id: 'config/optmerge#replace', doc: true
      in: { ref: 'r', shape: { policy: { '$MERGE': 'replace' } }
            doc: { default: { r: { options: { policy: { hosts: ['a.example'], strict: true } } } }
                   instance: { r: { options: { policy: { hosts: ['b.example'] } } } } } }
      out: { policy: { hosts: ['b.example'] } }
    }
    # append — concatenates, and is the ONLY way to get list append.
    {
      in: { ref: 'r', shape: { p: { '$MERGE': 'append' } }
            doc: { default: { r: { options: { p: ['x'] } } }
                   instance: { r: { options: { p: ['y'] } } } } }
      out: { p: ['x', 'y'] }
    }
    # deep: N — merge N levels below the key, replace below that.
    # Station's `feature` needs exactly deep:2 — by feature name, then by
    # option key, replacing below. Here `headers` (level 3) replaces
    # wholesale while `retry`'s other keys survive.
    {
      id: 'config/optmerge#deep2'
      in: { ref: 'r', shape: { feature: { '$MERGE': { deep: 2 } } }
            doc: { default: { r: { options: { feature: { retry: { n: 3, headers: { a: 1, b: 2 } } } } } }
                   instance: { r: { options: { feature: { retry: { headers: { c: 3 } } } } } } } }
      out: { feature: { retry: { n: 3, headers: { c: 3 } } } }
    }
    # deep:1 merges one level and replaces below it.
    {
      in: { ref: 'r', shape: { m: { '$MERGE': { deep: 1 } } }
            doc: { default: { r: { options: { m: { a: { x: 1 }, b: 2 } } } }
                   instance: { r: { options: { m: { a: { y: 2 } } } } } } }
      out: { m: { a: { y: 2 }, b: 2 } }
    }
    # A definition that says nothing gets deep-for-maps and never learns
    # the key exists.
    {
      in: { ref: 'r', doc: { default: { r: { options: { m: { a: { x: 1 }, b: 2 } } } }
                             instance: { r: { options: { m: { a: { y: 2 } } } } } } }
      out: { m: { a: { x: 1, y: 2 }, b: 2 } }
    }
  ]


  # N IS AN INTEGER OF AT LEAST 1, AND EVERYTHING ELSE IS AN ERROR (§9.4).
  # Raised when the SHAPE ENTERS THE CATALOG, not when a document happens
  # to exercise the key, so a malformed shape fails once and in the same
  # place everywhere.
  #
  # Stating the domain is not pedantry: without it each port picks its own
  # reading of {"deep": 0} — reject, replace, unlimited merge, or clamp to
  # 1 — and the same document resolves differently per language. deep:0 is
  # rejected DESPITE having an obvious reading, because "replace at this
  # key" already has a spelling and two spellings for one behaviour is the
  # defect class this repo exists to avoid.
  optmergebad: set: [
    { id: 'config/optmergebad#zero', doc: true
      in: { ref: 'r', shape: { m: { '$MERGE': { deep: 0 } } } }, err: 'plugin_shape_invalid' }
    { in: { ref: 'r', shape: { m: { '$MERGE': { deep: -1 } } } }, err: 'plugin_shape_invalid' }
    { in: { ref: 'r', shape: { m: { '$MERGE': { deep: 1.5 } } } }, err: 'plugin_shape_invalid' }
    { in: { ref: 'r', shape: { m: { '$MERGE': { deep: 'two' } } } }, err: 'plugin_shape_invalid' }
    { in: { ref: 'r', shape: { m: { '$MERGE': { deep: null } } } }, err: 'plugin_shape_invalid' }
    { in: { ref: 'r', shape: { m: { '$MERGE': 'merge' } } }, err: 'plugin_shape_invalid' }
    { in: { ref: 'r', shape: { m: { '$MERGE': 'REPLACE' } } }, err: 'plugin_shape_invalid' }
    { in: { ref: 'r', shape: { m: { '$MERGE': true } } }, err: 'plugin_shape_invalid' }
    { in: { ref: 'r', shape: { m: { '$MERGE': {} } } }, err: 'plugin_shape_invalid' }
    # The error names the key and the directive, so a shape with two
    # problems is diagnosable without bisecting it.
    { in: { ref: 'r', shape: { m: { '$MERGE': { deep: 0 } } } }
      err: true, match: { err: { message: '/m/' } } }
  ]
}
